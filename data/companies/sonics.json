  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "가동률",
      "desc": "생산시설이 사용할 수 있는 능력에 비해 실제로 얼마나 사용됐는지를 나타내는 비율입니다."
    },
    {
      "name": "수율",
      "desc": "투입·생산한 물량 중 정상 제품으로 완성되는 비율입니다."
    },
    {
      "name": "위탁생산",
      "desc": "다른 회사의 주문을 받아 제품을 대신 생산하는 사업입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "파운드리",
      "desc": "다른 회사가 설계한 반도체를 위탁 생산하는 사업입니다."
    },
    {
      "name": "패키징",
      "desc": "반도체 칩을 보호하고 외부 회로와 연결할 수 있게 가공하는 과정입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "RF",
      "desc": "무선통신에 사용하는 고주파 신호를 뜻합니다."
    },
    {
      "name": "웨이퍼",
      "desc": "반도체 회로를 만드는 얇고 둥근 원판입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "SAW",
      "desc": "표면탄성파를 이용하는 기술로, 통신 필터 등에서 특정 주파수를 골라내는 데 활용됩니다."
    }
  ],
