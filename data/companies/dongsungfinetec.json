  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "수율",
      "desc": "투입·생산한 제품 중 정상적으로 사용할 수 있는 제품의 비율입니다."
    },
    {
      "name": "LNG",
      "desc": "액화천연가스로, 매우 낮은 온도로 냉각해 액체 상태로 운송·보관합니다."
    },
    {
      "name": "LPG",
      "desc": "액화석유가스로, 프로판·부탄 등을 액체 상태로 운송·사용합니다."
    },
    {
      "name": "냉매",
      "desc": "냉장고·에어컨 등에서 열을 옮겨 냉각하는 데 사용하는 물질입니다."
    },
    {
      "name": "보냉재",
      "desc": "매우 낮은 온도를 유지하도록 외부 열 유입을 줄이는 단열 소재입니다."
    },
    {
      "name": "폴리우레탄",
      "desc": "탄성·완충·단열 등 용도로 활용하는 고분자 소재입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "단열",
      "desc": "열이 전달되는 것을 줄이는 기능입니다."
    },
    {
      "name": "PU",
      "desc": "폴리우레탄으로, 단열·보냉재 등 다양한 제품에 사용하는 고분자 소재입니다."
    }
  ],
