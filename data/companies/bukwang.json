  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "도입 상품",
      "desc": "외부 회사에서 제품을 공급받거나 판매 권리를 확보해 판매하는 상품입니다. 직접 제조 제품과 원가·계약 조건이 다를 수 있습니다."
    },
    {
      "name": "의약외품",
      "desc": "의약품과 구분해 관리하는 보건 관련 제품 분류입니다. 일부 구강·위생 제품 등이 해당합니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "상업화",
      "desc": "연구·개발한 제품이나 기술을 허가·생산·판매 등 실제 사업으로 연결하는 과정입니다."
    },
    {
      "name": "건강기능식품",
      "desc": "인정된 기능성 원료나 성분 등을 사용해 제조하는 식품 분류입니다. 의약품과 구분합니다."
    }
