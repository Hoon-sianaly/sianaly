  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "합금철",
      "desc": "철강에 필요한 성질을 부여하기 위해 넣는 철과 다른 금속 등의 합금입니다."
    },
    {
      "name": "프레스",
      "desc": "금속 등에 압력을 가해 원하는 모양으로 성형하는 기계입니다."
    },
    {
      "name": "비철금속",
      "desc": "아연·구리·알루미늄처럼 철을 주성분으로 하지 않는 금속입니다."
    },
    {
      "name": "Roll",
      "desc": "제지·제철 등 생산설비에 사용하는 원통형 회전 부품입니다."
    },
    {
      "name": "이익률",
      "desc": "매출 등 수익에 비해 이익이 얼마나 남는지 나타내는 비율입니다. 어떤 이익을 사용했는지 구분해야 합니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    }
  ],
