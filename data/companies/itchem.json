  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "수율",
      "desc": "투입하거나 생산한 제품 중 규격을 충족한 양품의 비율입니다."
    },
    {
      "name": "OLED",
      "desc": "전류를 흘리면 유기 발광 재료가 스스로 빛을 내는 디스플레이 기술입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "원료의약품",
      "desc": "완성된 약의 치료 작용을 내는 주성분으로 사용되는 물질입니다."
    },
    {
      "name": "디스플레이",
      "desc": "정보나 영상을 보여주는 화면 장치 또는 화면 패널을 뜻합니다."
    },
    {
      "name": "전자재료",
      "desc": "반도체·디스플레이 등 전자제품의 제조와 기능 구현에 사용하는 소재입니다."
    },
    {
      "name": "의견거절",
      "desc": "감사인이 충분한 감사증거를 확보하지 못하는 등의 사유로 재무제표에 의견을 제시하지 않는 것입니다."
    },
    {
      "name": "적정",
      "desc": "감사인이 재무제표가 회계기준에 따라 중요하게 왜곡되지 않았다고 판단한 의견입니다. 투자 안전이나 미래 이익을 보증하는 뜻은 아닙니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "중간체",
      "desc": "최종 소재·의약품을 만들기 전 합성 과정에서 생기는 중간 물질입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
  ],
