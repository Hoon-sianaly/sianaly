  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "복합 소재",
      "desc": "둘 이상의 소재를 결합해 강도·무게·내구성 등의 특성을 개선한 소재입니다."
    },
    {
      "name": "바이오 소재",
      "desc": "생물 유래 성분이나 생명과학 기술 등을 활용한 소재로, 화장품·건강·의료 제품 등에 사용합니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "기능성",
      "desc": "일반 제품의 기본 용도에 더해 특정 성능이나 사용 목적에 맞춘 특성을 뜻합니다."
    },
    {
      "name": "펩타이드",
      "desc": "여러 아미노산이 짧은 사슬 형태로 연결된 물질입니다."
    },
    {
      "name": "용역",
      "desc": "제품 판매와 달리 공정 개발·분석·작업 등 서비스를 제공하는 사업입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "스킨부스터",
      "desc": "피부 상태 개선을 목적으로 쓰는 시술용 제품군의 명칭입니다. 품목별 용도·허가 조건은 다를 수 있습니다."
    },
    {
      "name": "엑소좀",
      "desc": "세포가 분비하는 작은 입자로 내부 성분을 전달하며 연구·소재 개발 등에 활용됩니다."
    }
  ],
