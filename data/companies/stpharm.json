  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "가동률",
      "desc": "공장·설비가 생산능력에 비해 실제로 사용된 정도입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "임상",
      "desc": "사람을 대상으로 의약품 등의 안전성과 효과를 평가하는 시험입니다."
    },
    {
      "name": "원료의약품",
      "desc": "완성된 의약품을 만드는 데 사용하는 주요 약효 성분 등 원료입니다."
    },
    {
      "name": "위탁개발",
      "desc": "다른 회사의 요청을 받아 제품·기술 개발을 대신 수행하는 사업입니다."
    },
    {
      "name": "제네릭",
      "desc": "특허 등이 만료된 기존 의약품과 같은 유효성분으로 개발한 복제약입니다."
    },
    {
      "name": "상업화",
      "desc": "연구·개발한 제품이나 기술을 허가·생산·판매 등 실제 사업으로 연결하는 과정입니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "핵산",
      "desc": "유전정보를 저장·전달하는 DNA·RNA 등을 구성하는 물질입니다."
    },
    {
      "name": "mRNA",
      "desc": "단백질을 만드는 정보를 전달하는 RNA로, 일부 백신·치료제 기술에 사용합니다."
    },
    {
      "name": "위탁개발생산",
      "desc": "고객의 제품 개발·공정 설계·제조 등을 맡아 수행하는 사업입니다."
    },
    {
      "name": "올리고뉴클레오타이드",
      "desc": "짧은 핵산 사슬로, 일부 유전자·RNA 치료제의 원료로 사용합니다."
    },
    {
      "name": "CDMO",
      "desc": "의약품의 제조 공정 개발과 생산을 고객사 대신 수행하는 사업입니다."
    }
