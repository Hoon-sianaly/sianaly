  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "전구체",
      "desc": "다른 소재로 전환되기 전 단계의 물질입니다. 배터리에서는 양극재의 원료, 반도체에서는 증착 등에 쓰는 원료를 뜻할 수 있습니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "증착",
      "desc": "반도체 기판 등에 필요한 물질을 얇은 막 형태로 쌓는 제조 공정입니다."
    },
    {
      "name": "ALD",
      "desc": "원자층 증착으로, 표면 반응을 반복해 매우 얇고 균일한 막을 만드는 공정입니다."
    },
    {
      "name": "LPCVD",
      "desc": "낮은 압력에서 화학 반응을 이용해 기판에 박막을 만드는 증착 방식입니다."
    },
    {
      "name": "플라즈마",
      "desc": "기체가 전기적 에너지를 받아 이온·전자 등을 포함하는 상태로, 반도체 가공 등에 활용합니다."
    }
  ],
