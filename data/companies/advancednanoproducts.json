  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "가동률",
      "desc": "공장·설비가 생산능력에 비해 실제로 사용된 정도입니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "CMP",
      "desc": "화학·기계적 작용을 결합해 웨이퍼 표면 등을 평탄하게 가공하는 공정입니다."
    },
    {
      "name": "디스플레이",
      "desc": "정보나 영상을 보여주는 화면 장치 또는 화면 패널을 뜻합니다."
    },
    {
      "name": "태양광",
      "desc": "햇빛을 태양전지 등으로 전기에너지로 바꾸는 발전 방식입니다."
    },
    {
      "name": "기능성",
      "desc": "일반 제품의 기본 용도에 더해 특정 성능이나 사용 목적에 맞춘 특성을 뜻합니다."
    },
    {
      "name": "CNT",
      "desc": "탄소나노튜브로, 전기 전달 등을 돕는 배터리 도전재에 활용합니다."
    },
    {
      "name": "도전재",
      "desc": "전극 등에서 전기가 잘 흐르도록 돕는 첨가 소재입니다."
    },
    {
      "name": "슬러리",
      "desc": "미세 입자 등을 액체에 분산시킨 혼합물로 연마·코팅 등에 사용합니다."
    },
    {
      "name": "타겟",
      "desc": "여기서는 박막을 입힐 때 필요한 물질을 공급하는 고체 소재를 뜻합니다."
    }
  ],
