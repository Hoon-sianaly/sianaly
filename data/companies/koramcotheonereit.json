  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "차입",
      "desc": "은행 대출이나 채권 발행 등으로 외부에서 돈을 빌리는 것입니다."
    },
    {
      "name": "리츠",
      "desc": "여러 투자자의 자금을 모아 부동산 등에 투자하고 관련 수익을 배당하는 부동산투자회사입니다."
    },
    {
      "name": "공실",
      "desc": "임차인이 없어 사용되지 않는 임대 공간입니다."
    },
    {
      "name": "차환",
      "desc": "만기가 돌아오는 차입금을 새로 빌린 돈 등으로 상환하는 것입니다."
    },
    {
      "name": "임차인",
      "desc": "건물·토지 등을 빌려 사용하고 임대료를 내는 사람이나 회사입니다."
    },
    {
      "name": "배당",
      "desc": "회사가 정해진 절차에 따라 주주에게 나누어 지급하는 돈이나 주식입니다."
    },
    {
      "name": "임대 수입",
      "desc": "보유 자산을 다른 사람이나 회사가 사용하도록 빌려주고 받는 대가입니다."
    },
    {
      "name": "재원",
      "desc": "사업이나 지급에 필요한 돈의 원천입니다. 배당 재원과 회계상 순이익은 같지 않을 수 있습니다."
    }
  ],
