  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "철스크랩",
      "desc": "철강을 다시 만들 때 원료로 사용하는 고철입니다."
    },
    {
      "name": "가동률",
      "desc": "공장이나 설비가 생산 가능한 능력 중 실제로 사용하는 비율입니다."
    },
    {
      "name": "고정비",
      "desc": "생산·판매량이 달라져도 단기간에는 크게 변하지 않는 비용입니다."
    },
    {
      "name": "철근",
      "desc": "콘크리트 구조물의 강도를 보완하기 위해 넣는 철강 봉 제품입니다."
    },
    {
      "name": "전기로",
      "desc": "전기를 열원으로 사용해 고철 등 금속 원료를 녹이는 설비입니다."
    },
    {
      "name": "압연",
      "desc": "금속을 회전하는 롤 사이로 통과시켜 두께나 모양을 바꾸는 가공 방법입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "지주회사",
      "desc": "다른 회사의 주식을 보유해 계열사를 지배·관리하는 회사입니다. 자체 사업을 함께 운영하기도 합니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    }
  ],
