  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "플랜트",
      "desc": "제품을 생산하거나 에너지·환경 처리를 수행하는 산업 설비입니다."
    },
    {
      "name": "감가상각",
      "desc": "설비·장비 등의 취득 비용을 사용 기간에 걸쳐 나누어 비용으로 반영하는 것입니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "엔지니어링",
      "desc": "전문기술을 활용해 시설·시스템을 조사·설계·구축·관리하는 업무입니다."
    },
    {
      "name": "CNT",
      "desc": "탄소나노튜브입니다. 매우 작은 관 형태의 탄소 소재로 전도성 개선 등에 사용됩니다."
    },
    {
      "name": "도전재",
      "desc": "배터리 전극 안에서 전기가 잘 흐르도록 돕는 첨가 소재입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
  ],
