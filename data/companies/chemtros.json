  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "원료의약품",
      "desc": "완성된 약의 치료 작용을 내는 주성분으로 사용되는 물질입니다."
    },
    {
      "name": "디스플레이",
      "desc": "정보나 영상을 보여주는 화면 장치 또는 화면 패널을 뜻합니다."
    },
    {
      "name": "내부회계관리제도",
      "desc": "재무정보를 신뢰할 수 있게 작성하기 위한 회사의 절차와 통제 체계입니다. 제도에 대한 감사의견과 재무제표 감사의견은 서로 다릅니다."
    },
    {
      "name": "적정",
      "desc": "감사인이 재무제표가 회계기준에 따라 중요하게 왜곡되지 않았다고 판단한 의견입니다. 투자 안전이나 미래 이익을 보증하는 뜻은 아닙니다."
    },
    {
      "name": "부적정",
      "desc": "감사 대상에 중요한 문제가 광범위하게 있다고 판단한 의견입니다. 이 페이지에서는 재무제표와 내부회계관리제도 중 어느 대상인지 함께 표시합니다."
    },
    {
      "name": "기능성",
      "desc": "일반 제품의 기본 용도에 더해 특정 성능이나 사용 목적에 맞춘 특성을 뜻합니다."
    },
    {
      "name": "전해액",
      "desc": "배터리 내부에서 이온이 이동할 수 있도록 하는 액체 소재입니다."
    },
    {
      "name": "중간체",
      "desc": "최종 소재·의약품을 만들기 전 합성 과정에서 생기는 중간 물질입니다."
    },
    {
      "name": "첨가제",
      "desc": "기본 재료에 기능·품질 개선을 위해 소량 넣는 물질입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
  ],
