  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "파운드리",
      "desc": "다른 회사가 설계한 반도체를 위탁 생산하는 사업입니다."
    },
    {
      "name": "리스",
      "desc": "회사 등이 구입한 자산을 고객이 일정 기간 사용하고 사용료를 내는 방식입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "후공정",
      "desc": "반도체 회로 형성 이후 칩을 자르고 포장·검사하는 단계입니다."
    },
    {
      "name": "팹리스",
      "desc": "자체 반도체 제조 공장보다 설계에 집중하고 생산은 외부 전문 업체를 활용하는 기업입니다."
    },
    {
      "name": "포토마스크",
      "desc": "반도체·디스플레이 회로의 모양을 빛으로 전달하기 위한 원판입니다."
    },
    {
      "name": "패키지",
      "desc": "반도체 칩을 보호하고 외부 회로와 연결하도록 구성한 제품 단위입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
  ],
