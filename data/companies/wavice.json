  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "수율",
      "desc": "투입·생산한 물량 중 정상 제품으로 완성되는 비율입니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "방산",
      "desc": "군사 장비·무기와 관련 기술·서비스를 공급하는 방위산업입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "고주파",
      "desc": "미용 의료기기 문맥에서는 전자기 에너지로 조직에 열을 전달하는 방식을 뜻합니다."
    },
    {
      "name": "RF",
      "desc": "무선통신 등에 사용하는 고주파 전기신호를 뜻합니다."
    },
    {
      "name": "패키지",
      "desc": "반도체 칩을 보호하고 외부 회로와 연결하도록 구성한 제품 단위입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "모듈",
      "desc": "특정 기능을 수행하도록 여러 부품을 결합한 구성 단위입니다."
    },
    {
      "name": "질화갈륨",
      "desc": "높은 전력과 고주파 신호를 다루는 반도체 등에 쓰이는 화합물 소재입니다."
    }
