    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "손상",
      "desc": "자산에서 회수할 수 있는 금액이 장부금액보다 줄어든 경우 이를 회계에 반영하는 것입니다."
    },
    {
      "name": "리스",
      "desc": "자산을 일정 기간 사용할 권리를 제공하고 이용료를 받는 계약입니다."
    },
    {
      "name": "의견거절",
      "desc": "감사인이 충분한 근거를 확보하지 못하는 등 이유로 재무제표에 감사의견을 표명하지 않은 상태입니다."
    },
    {
      "name": "적정",
      "desc": "감사인이 재무제표가 회계기준에 따라 중요하게 왜곡되지 않았다고 판단한 의견입니다. 투자 안전이나 미래 이익을 보증하는 뜻은 아닙니다."
    },
    {
      "name": "키오스크",
      "desc": "주문·결제·안내 등을 이용자가 직접 처리하는 무인 단말기입니다."
    }
