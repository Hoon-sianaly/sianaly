  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "손상",
      "desc": "자산의 회수 가능 가치가 장부금액보다 낮아졌을 때 손실을 회계에 반영하는 것입니다."
    },
    {
      "name": "배당",
      "desc": "회사가 정해진 절차에 따라 주주에게 나누어 지급하는 돈이나 주식입니다."
    },
    {
      "name": "벤처 투자",
      "desc": "초기·성장 단계 기업 등에 자금을 투자하고 성장·회수를 추진하는 사업입니다."
    },
    {
      "name": "투자조합",
      "desc": "여러 출자자의 자금을 모아 기업 등에 투자하는 조직입니다."
    },
    {
      "name": "관리보수",
      "desc": "펀드·조합의 운용·관리 대가로 받는 수수료입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "영업수익",
      "desc": "회사의 주된 영업활동에서 발생하는 수익입니다. 금융·투자 회사에서는 대출 원금이나 펀드 규모와 구분합니다."
    }
  ],
