  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "임상",
      "desc": "사람을 대상으로 의약품 등의 안전성과 효과를 평가하는 시험입니다."
    },
    {
      "name": "기술이전",
      "desc": "개발 기술이나 권리를 다른 회사에 제공하고 계약금·단계별 대금 등을 받는 계약입니다."
    },
    {
      "name": "약물 전달",
      "desc": "약물이 몸 안의 목표 부위에 도달하도록 설계하는 기술·방식입니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "펩타이드",
      "desc": "여러 아미노산이 연결된 물질로, 구조에 따라 다양한 기능을 가질 수 있습니다."
    },
    {
      "name": "GLP-1",
      "desc": "혈당·식욕 조절 등에 관여하는 호르몬 작용을 활용한 의약품 계열입니다."
    },
    {
      "name": "ORALINK",
      "desc": "디앤디파마텍의 펩타이드 약물 경구 전달 기술 플랫폼 명칭입니다."
    },
    {
      "name": "경구",
      "desc": "약물을 입으로 복용하는 투여 방식을 뜻합니다."
    },
    {
      "name": "용역",
      "desc": "제품 판매와 달리 공정 개발·분석·작업 등 서비스를 제공하는 사업입니다."
    }
  ],
