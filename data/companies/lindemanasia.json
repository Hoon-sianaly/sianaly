  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "지분법",
      "desc": "투자한 회사의 손익 중 보유 지분에 해당하는 부분 등을 투자회사의 손익에 반영하는 회계 방식입니다."
    },
    {
      "name": "벤처투자",
      "desc": "성장 가능성이 있는 초기·신생 기업 등에 자금을 투자하는 사업입니다."
    },
    {
      "name": "사모펀드",
      "desc": "제한된 투자자의 자금을 모아 운용하는 펀드입니다."
    },
    {
      "name": "투자조합",
      "desc": "여러 출자자의 자금을 모아 기업 등에 투자하는 조직입니다."
    },
    {
      "name": "관리보수",
      "desc": "펀드·조합의 운용·관리 대가로 받는 수수료입니다."
    },
    {
      "name": "성과보수",
      "desc": "계약에서 정한 투자 성과 조건을 충족하면 받는 추가 보수입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "영업수익",
      "desc": "회사의 주된 영업활동에서 발생하는 수익입니다. 금융·투자 회사에서는 대출 원금이나 펀드 규모와 구분합니다."
    },
    {
      "name": "PE",
      "desc": "폴리에틸렌의 약자로 포장 필름 등 다양한 제품의 원료가 되는 플라스틱입니다."
    }
  ],
