  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "임상",
      "desc": "사람을 대상으로 의약품 등의 안전성과 효과를 확인하는 연구 단계입니다."
    },
    {
      "name": "위탁개발",
      "desc": "다른 회사의 요청을 받아 제품·기술 개발을 대신 수행하는 사업입니다."
    },
    {
      "name": "바이오의약품",
      "desc": "생물 유래 물질이나 생명공학 기술 등을 이용해 만드는 의약품입니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "심지",
      "desc": "옷의 형태를 잡거나 겉감을 보강하기 위해 안쪽에 덧대는 부자재입니다."
    },
    {
      "name": "핵산",
      "desc": "DNA·RNA처럼 유전정보를 담거나 전달하는 분자입니다."
    },
    {
      "name": "DNA",
      "desc": "생물의 유전정보를 저장하는 핵산입니다."
    },
    {
      "name": "mRNA",
      "desc": "유전정보를 전달해 세포가 단백질을 만들도록 돕는 핵산입니다."
    },
    {
      "name": "위탁개발생산",
      "desc": "고객의 제품 개발·공정 설계·제조 등을 맡아 수행하는 사업입니다."
    }
  ],
