    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "가동률",
      "desc": "공장이나 설비가 생산 가능한 능력 중 실제로 사용하는 비율입니다."
    },
    {
      "name": "차입",
      "desc": "은행 대출이나 채권 발행 등으로 외부에서 돈을 빌리는 것입니다."
    },
    {
      "name": "감가상각",
      "desc": "차량·설비 등 자산의 취득 비용을 사용 기간에 걸쳐 나눠 비용으로 반영하는 회계 처리입니다."
    },
    {
      "name": "렌털",
      "desc": "제품을 구매하는 대신 일정 기간 이용료를 내고 빌려 사용하는 방식입니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "파렛트",
      "desc": "물건을 올려 운반·보관하기 위한 받침대입니다. 팔레트라고도 합니다."
    },
    {
      "name": "고소장비",
      "desc": "높은 곳에서 사람이 작업할 수 있도록 올려주는 산업용 장비입니다."
    }
  ],
