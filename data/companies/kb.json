    },
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "순이자이익",
      "desc": "이자수익에서 이자비용을 뺀 금액입니다. 수수료·투자 손익까지 포함한 전체 이익은 아닙니다."
    },
    {
      "name": "순이자마진",
      "desc": "이자를 얻는 자산에 비해 순이자이익이 얼마나 발생했는지 나타내는 비율입니다."
    },
    {
      "name": "보통주자본비율",
      "desc": "위험을 반영한 자산 대비 손실을 흡수할 수 있는 보통주 중심 자본의 비율입니다."
    },
    {
      "name": "신용손실",
      "desc": "대출이나 채권에서 약정된 돈을 받지 못할 것으로 예상하거나 실제 발생한 손실입니다."
    },
    {
      "name": "기업금융",
      "desc": "기업의 자금조달·투자·인수합병 등에 필요한 금융 서비스를 제공하는 사업입니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "배당",
      "desc": "회사가 정해진 절차에 따라 주주에게 나누어 지급하는 돈이나 주식입니다."
