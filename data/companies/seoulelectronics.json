  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "ODM",
      "desc": "제품 개발·설계부터 생산까지 맡아 고객 브랜드로 공급하는 방식입니다."
    },
    {
      "name": "키오스크",
      "desc": "사용자가 화면 등을 직접 조작해 주문·결제·환전 등을 수행하는 무인 단말기입니다."
    },
    {
      "name": "전장",
      "desc": "자동차 등에 들어가는 전기·전자 장치와 부품을 뜻합니다."
    },
    {
      "name": "단말",
      "desc": "이용자가 통신망·서비스에 접속하기 위해 사용하는 장치입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "SMPS",
      "desc": "전기를 빠르게 켜고 끄는 방식으로 전압 등을 변환하는 전원 공급장치입니다."
    },
    {
      "name": "트랜스포머",
      "desc": "전기 에너지를 전달하며 전압 등을 바꾸는 변압기입니다."
    }
  ],
