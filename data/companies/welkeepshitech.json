  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "가동률",
      "desc": "생산시설이 사용할 수 있는 능력에 비해 실제로 얼마나 사용됐는지를 나타내는 비율입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "패키징",
      "desc": "반도체 칩을 보호하고 외부 회로와 연결할 수 있게 가공하는 과정입니다."
    },
    {
      "name": "디스플레이",
      "desc": "정보나 영상을 보여주는 화면 장치 또는 화면 패널을 뜻합니다."
    },
    {
      "name": "전장",
      "desc": "자동차 등에 들어가는 전기·전자 장치와 부품을 뜻합니다."
    },
    {
      "name": "후공정",
      "desc": "반도체 회로 형성 이후 칩을 자르고 포장·검사하는 단계입니다."
    },
    {
      "name": "IC",
      "desc": "집적회로로, 여러 전자소자를 하나의 칩에 통합한 회로입니다."
    },
    {
      "name": "버스바",
      "desc": "비교적 큰 전류를 전달하는 막대·판 형태의 전도체입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "트랜스포머",
      "desc": "전기 에너지를 전달하며 전압 등을 바꾸는 변압기입니다."
    }
  ],
