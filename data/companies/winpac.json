  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "가동률",
      "desc": "생산시설이 사용할 수 있는 능력에 비해 실제로 얼마나 사용됐는지를 나타내는 비율입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "패키징",
      "desc": "반도체 칩을 보호하고 외부 회로와 연결할 수 있게 가공하는 과정입니다."
    },
    {
      "name": "고정비",
      "desc": "생산·판매량이 달라져도 단기간에는 크게 변하지 않는 비용입니다."
    },
    {
      "name": "밀봉",
      "desc": "틈으로 공기·물·유체 등이 새거나 들어오는 것을 막는 기능입니다."
    },
    {
      "name": "후공정",
      "desc": "반도체 회로 형성 이후 칩을 자르고 포장·검사하는 단계입니다."
    },
    {
      "name": "패키지",
      "desc": "반도체 칩을 보호하고 외부 회로와 연결하도록 구성한 제품 단위입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
