  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "디스플레이",
      "desc": "정보나 영상을 보여주는 화면 장치 또는 화면 패널을 뜻합니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "마진",
      "desc": "판매가격과 관련 비용 사이의 차이 또는 이익의 정도입니다."
    },
    {
      "name": "SSD",
      "desc": "반도체 메모리를 이용하는 데이터 저장장치입니다."
    },
    {
      "name": "DRAM",
      "desc": "전원이 공급되는 동안 데이터를 저장하는 메모리 반도체로 PC·서버·모바일 기기 등에 사용됩니다."
    },
    {
      "name": "NAND",
      "desc": "전원이 꺼져도 데이터를 유지하는 플래시 메모리 계열입니다."
    },
    {
      "name": "전력관리",
      "desc": "전자기기에 필요한 전압·전류·전력 사용을 조절하는 기능입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
