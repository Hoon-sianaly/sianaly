  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "가동률",
      "desc": "생산시설이 사용할 수 있는 능력에 비해 실제로 얼마나 사용됐는지를 나타내는 비율입니다."
    },
    {
      "name": "수율",
      "desc": "투입·생산한 물량 중 정상 제품으로 완성되는 비율입니다."
    },
    {
      "name": "ODM",
      "desc": "제품 개발·설계부터 생산까지 맡아 고객 브랜드로 공급하는 방식입니다."
    },
    {
      "name": "OEM",
      "desc": "고객의 상표로 제품을 대신 생산하는 방식입니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "제형",
      "desc": "정제·캡슐·분말·액상 등 제품을 복용·사용할 수 있게 만든 형태입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "하이드로겔",
      "desc": "물을 많이 포함하는 젤 형태의 소재로, 마스크팩·패치 등에 쓰입니다."
    }
  ],
