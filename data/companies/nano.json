  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "질소산화물",
      "desc": "연소 과정 등에서 발생하는 대기오염 물질로, 배출 저감 설비의 처리 대상입니다."
    },
    {
      "name": "이산화티타늄",
      "desc": "흰색을 내는 안료 등에 쓰는 화학 소재입니다."
    },
    {
      "name": "적정",
      "desc": "감사인이 재무제표가 회계기준에 따라 중요하게 왜곡되지 않았다고 판단한 의견입니다. 투자 안전이나 미래 이익을 보증하는 뜻은 아닙니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "용역",
      "desc": "제품 판매와 달리 공정 개발·분석·작업 등 서비스를 제공하는 사업입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "SCR",
      "desc": "촉매를 이용해 배기가스의 질소산화물을 줄이는 방식입니다."
    },
    {
      "name": "탈질촉매",
      "desc": "배기가스의 질소산화물을 줄이는 반응을 돕는 소재입니다."
    },
    {
      "name": "한정의견",
      "desc": "일부 중요한 사항에 제약이나 문제가 있어 해당 부분을 제외하고 적정하다고 판단한 감사의견입니다."
    }
  ],
