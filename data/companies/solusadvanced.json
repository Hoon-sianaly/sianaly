  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "가동률",
      "desc": "생산설비가 만들 수 있는 양에 비해 실제 얼마나 생산하고 있는지를 나타내는 비율입니다."
    },
    {
      "name": "OLED",
      "desc": "소자가 스스로 빛을 내는 유기발광다이오드 디스플레이 기술입니다."
    },
    {
      "name": "전지박",
      "desc": "배터리에서 전류를 모으는 데 쓰는 매우 얇은 금속박으로, 여기서는 구리박을 뜻합니다."
    },
    {
      "name": "집전체",
      "desc": "배터리 전극에서 전자를 모아 외부 회로와 연결하는 금속 소재입니다."
    },
    {
      "name": "계속사업",
      "desc": "회사가 중단하기로 분류한 사업을 제외하고 계속 운영하는 사업입니다."
    },
    {
      "name": "중단사업",
      "desc": "매각하거나 종료하는 등 회계기준상 별도로 구분하는 사업입니다."
    }
  ],
