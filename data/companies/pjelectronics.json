  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "가동률",
      "desc": "생산시설이 사용할 수 있는 능력에 비해 실제로 얼마나 사용됐는지를 나타내는 비율입니다."
    },
    {
      "name": "위탁생산",
      "desc": "다른 회사의 주문을 받아 제품을 대신 생산하는 사업입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "마진",
      "desc": "판매가격과 관련 비용 사이의 차이 또는 이익의 정도입니다."
    },
    {
      "name": "EMS",
      "desc": "고객사를 대신해 전자제품이나 부품의 생산·조립 등을 수행하는 사업입니다."
    },
    {
      "name": "실장",
      "desc": "기판 위에 칩 등 전자부품을 배치·접합하는 공정입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
  ],
