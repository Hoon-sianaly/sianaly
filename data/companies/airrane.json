  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "수율",
      "desc": "투입·생산한 물량 중 정상 제품으로 완성되는 비율입니다."
    },
    {
      "name": "분리막",
      "desc": "배터리 양극과 음극이 직접 닿지 않도록 분리하면서 이온은 통과시키는 소재입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "바이오가스",
      "desc": "유기성 폐자원 등을 분해해 얻는 가스로 발전·열 생산 등에 활용합니다."
    },
    {
      "name": "고분자",
      "desc": "작은 분자가 반복 연결된 큰 분자로, 수지 등 소재의 바탕이 됩니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "모듈",
      "desc": "특정 기능을 수행하도록 여러 부품을 결합한 구성 단위입니다."
    },
    {
      "name": "중공사",
      "desc": "가운데가 비어 있는 가느다란 섬유로, 분리막 등에 사용됩니다."
    }
  ],
