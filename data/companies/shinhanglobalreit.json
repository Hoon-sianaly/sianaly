  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "평가손익",
      "desc": "자산·부채 등의 평가금액이 변하면서 인식한 이익이나 손실로, 실제 현금 유입·유출과 다를 수 있습니다."
    },
    {
      "name": "리츠",
      "desc": "여러 투자자의 자금을 모아 부동산 등에 투자하고 관련 수익을 배당하는 부동산투자회사입니다."
    },
    {
      "name": "배당",
      "desc": "회사가 정해진 절차에 따라 주주에게 나누어 지급하는 돈이나 주식입니다."
    },
    {
      "name": "재원",
      "desc": "사업이나 지급에 필요한 돈의 원천입니다. 배당 재원과 회계상 순이익은 같지 않을 수 있습니다."
    },
    {
      "name": "코어",
      "desc": "전자장치에서 자기력·전력 변환 등을 돕는 중심 자성 부품을 뜻합니다."
    },
    {
      "name": "자리츠",
      "desc": "다른 리츠가 지분 등을 통해 투자하는 하위 부동산투자회사입니다."
    },
    {
      "name": "환헤지",
      "desc": "환율 변화에 따른 손실 위험을 줄이기 위해 반대 방향의 금융 거래 등을 하는 것입니다."
    }
  ],
