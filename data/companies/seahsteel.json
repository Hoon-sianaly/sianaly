  "overview": {
    "short": "세아제강은 건설·조선·기계·에너지 산업에 쓰는 강관을 만드는 회사",
    "summary": "세아제강은 건설·조선·기계·에너지 산업에 쓰는 강관을 만드는 회사입니다. 강관은 철강으로 만든 관으로, 물이나 석유·가스를 운반하거나 구조물을 지탱하는 데 사용됩니다.",
    "takeaways": [
      "세아제강은 건설·조선·기계·에너지 산업에 쓰는 강관을 만드는 회사입니다.",
      "강관은 철강으로 만든 관으로, 물이나 석유·가스를 운반하거나 구조물을 지탱하는 데 사용됩니다.",
      "철강을 유통하는 에스에스아이케이와 강관을 생산하는 동아스틸도 연결 사업에 포함됩니다.",
      "원료인 강판 가격과 강관 판매가격의 차이, 국내외 고객의 주문이 수익성에 중요합니다.",
      "세아제강지주와는 다른 상장회사이므로 사업 범위와 실적을 구분해서 봐야 합니다."
    ],
    "business": [
      {
        "name": "배관·구조용 강관",
        "desc": "물·증기 등을 운반하는 배관과 건물·기계 구조물에 쓰는 강관을 생산합니다."
      },
      {
        "name": "에너지·특수 강관",
        "desc": "석유·가스 개발과 수송용 강관, 스테인리스 등 특수 소재 강관을 공급합니다."
      },
      {
        "name": "연결 제조·유통",
        "desc": "동아스틸의 강관 제조와 에스에스아이케이의 철강 도소매 사업이 연결 실적에 포함됩니다."
      }
    ],
    "drivers": [
      {
        "title": "원료와 판매가격",
        "desc": "강판을 사서 강관으로 가공하므로 원료 가격 상승을 제품 가격에 얼마나 반영하는지가 중요합니다."
      },
      {
        "title": "건설·에너지 주문",
        "desc": "국내 건설과 해외 석유·가스 투자에 따라 제품별 수요와 공장 가동률이 달라집니다."
      },
      {
        "title": "수출 조건",
        "desc": "주요 해외 시장의 수입 규제·관세와 환율 변화가 판매 물량과 수익성에 영향을 줄 수 있습니다."
      }
