  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "수율",
      "desc": "투입·생산한 물량 중 정상 제품으로 완성되는 비율입니다."
    },
    {
      "name": "차입",
      "desc": "은행 대출이나 채권 발행 등으로 외부에서 돈을 빌리는 것입니다."
    },
    {
      "name": "대손 비용",
      "desc": "대출·채권 등의 돈을 회수하지 못할 위험이나 실제 손실을 회계에 반영한 비용입니다."
    },
    {
      "name": "대출채권",
      "desc": "돈을 빌려준 사람이 원금과 이자 등의 상환을 받을 수 있는 권리입니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "대출 건전성",
      "desc": "대출금을 약정대로 회수할 수 있는지를 나타내는 상태입니다. 연체와 신용손실 등을 함께 확인합니다."
    },
    {
      "name": "마진",
      "desc": "판매가격과 관련 비용 사이의 차이 또는 이익의 정도입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "영업수익",
      "desc": "회사의 주된 영업활동에서 발생하는 수익입니다. 금융·투자 회사에서는 대출 원금이나 펀드 규모와 구분합니다."
    }
  ],
