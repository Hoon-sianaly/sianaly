  "glossary": [
    {
      "name": "지분",
      "desc": "한 회사의 주식을 소유한 몫입니다."
    },
    {
      "name": "지분법 이익",
      "desc": "투자한 기업의 이익 중 보유 지분 등을 반영해 회계에 인식하는 이익입니다. 현금으로 받은 배당과는 다릅니다."
    },
    {
      "name": "NAV",
      "desc": "보유자산의 평가 가치에 순현금 등을 반영한 순자산가치입니다. 평가 기준에 따라 달라집니다."
    },
    {
      "name": "포트폴리오",
      "desc": "투자하고 있는 기업과 자산의 묶음입니다."
    },
    {
      "name": "연결 기준",
      "desc": "지배하는 자회사를 하나의 기업집단으로 묶어 계산하는 방식입니다."
    },
    {
      "name": "중단사업",
      "desc": "매각 등으로 사업을 중단할 때, 계속 운영하는 사업과 구분해 표시하는 실적입니다."
    },
    {
      "name": "커머스",
      "desc": "상품이나 서비스를 사고파는 사업입니다. 이 페이지에서는 온라인 쇼핑·선물하기 등의 서비스를 뜻합니다."
    },
    {
      "name": "모빌리티",
      "desc": "사람이나 물건의 이동과 관련된 기술·제품·서비스·사업입니다. 차량과 이동 서비스를 포함합니다."
    },
    {
      "name": "지주회사",
      "desc": "다른 회사의 주식을 보유해 계열사를 지배·관리하는 회사입니다. 자체 사업을 함께 운영하기도 합니다."
    },
    {
      "name": "플랫폼",
      "desc": "여러 제품·기술을 개발하거나 서비스를 제공하는 데 활용하는 공통 기반입니다. 여기서는 약물 전달 등 기술 기반을 뜻합니다."
    },
    {
      "name": "이익률",
      "desc": "매출 등 수익에 비해 이익이 얼마나 남는지 나타내는 비율입니다. 어떤 이익을 사용했는지 구분해야 합니다."
    },
    {
      "name": "배당",
      "desc": "회사가 정해진 절차에 따라 주주에게 나누어 지급하는 돈이나 주식입니다."
    }
  ],
