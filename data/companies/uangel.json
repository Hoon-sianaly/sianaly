    },
    {
      "name": "솔루션",
      "desc": "특정 업무나 문제를 해결하기 위해 제공하는 제품·기술·서비스의 묶음입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "핵심망",
      "desc": "가입자·통화·데이터 연결 등을 처리하는 통신사업자 네트워크의 중심 부분입니다."
    },
    {
      "name": "eSIM",
      "desc": "실물 유심을 교체하지 않고 통신 요금제 정보를 내려받아 사용하는 내장형 가입자 인증 방식입니다."
    },
    {
      "name": "로밍",
      "desc": "해외 등에서 다른 통신사업자의 망을 이용해 통신 서비스를 사용하는 것입니다."
    },
    {
      "name": "과금",
      "desc": "이용량·요금제에 따라 서비스 요금을 계산하는 처리입니다."
    },
    {
      "name": "메시징",
      "desc": "문자나 메시지를 전달·처리하는 서비스와 시스템입니다."
    },
    {
      "name": "스마트러닝",
