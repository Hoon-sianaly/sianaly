  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "클라우드",
      "desc": "서버·저장·소프트웨어 등의 자원을 네트워크로 이용하는 서비스 방식입니다."
    },
    {
      "name": "솔루션",
      "desc": "특정 업무나 문제를 해결하기 위해 제공하는 제품·기술·서비스의 묶음입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "ERP",
      "desc": "회계·구매·생산 등 기업 업무를 통합 관리하는 시스템입니다."
    },
    {
      "name": "전자문서",
      "desc": "종이 대신 전자 형태로 작성·보관·전달하는 문서입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "구독",
      "desc": "서비스를 계속 이용하는 대가로 일정 기간마다 요금을 내는 방식입니다."
    },
    {
      "name": "EDI",
      "desc": "정해진 전자 형식으로 기업 간 주문·거래 문서를 주고받는 방식입니다."
    }
