  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "충당금",
      "desc": "미래에 발생할 것으로 예상되는 손실이나 지급 의무를 미리 회계에 반영한 금액입니다."
    },
    {
      "name": "차입",
      "desc": "은행 대출이나 채권 발행 등으로 외부에서 돈을 빌리는 것입니다."
    },
    {
      "name": "기업금융",
      "desc": "기업의 자금조달·투자·인수합병 등에 필요한 금융 서비스를 제공하는 사업입니다."
    },
    {
      "name": "순영업손익",
      "desc": "금융회사의 영업수익에서 관련 영업비용을 상계해 표시하는 지표입니다. 일반 제조업 매출이나 최종 영업이익과 구분합니다."
    },
    {
      "name": "자기자본 투자",
      "desc": "외부 고객의 자금이 아니라 회사가 보유한 자금 등을 투자하는 사업입니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    }
  ],
