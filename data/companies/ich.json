    },
    {
      "name": "수율",
      "desc": "투입·생산한 물량 중 정상 제품으로 완성되는 비율입니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "복합소재",
      "desc": "여러 소재를 결합해 강도·무게·내구성 등의 특성을 조절한 소재입니다."
    },
    {
      "name": "디스플레이",
      "desc": "정보나 영상을 보여주는 화면 장치 또는 화면 패널을 뜻합니다."
    },
    {
      "name": "필름",
      "desc": "얇은 막 형태의 소재로, 포장재와 전자 부품 등의 재료로 사용합니다."
    },
    {
      "name": "방열",
      "desc": "장치에서 발생한 열을 바깥으로 내보내는 기능입니다."
    },
    {
      "name": "안테나",
      "desc": "전자파 신호를 보내거나 받는 장치입니다."
    },
    {
      "name": "코팅",
      "desc": "소재 표면에 다른 물질을 얇게 입히는 공정입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "도전성",
      "desc": "전기가 통하는 성질입니다. 정전기를 제어하는 소재에도 활용됩니다."
    }
