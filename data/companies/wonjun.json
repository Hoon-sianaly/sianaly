  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "소성",
      "desc": "재료를 높은 온도로 구워 필요한 강도·특성을 얻는 공정입니다."
    },
    {
      "name": "지관",
      "desc": "종이를 여러 겹 감거나 붙여 만든 관입니다. 원단·필름 등을 감는 심 등에 씁니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "열처리",
      "desc": "재료를 정해진 온도로 가열·냉각해 성질을 바꾸는 공정입니다."
    },
    {
      "name": "소성로",
      "desc": "원료를 높은 온도에서 반응시켜 원하는 성질의 소재를 만드는 장비입니다."
    }
  ],
