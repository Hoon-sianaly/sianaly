  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "가동률",
      "desc": "생산시설이 사용할 수 있는 능력에 비해 실제로 얼마나 사용됐는지를 나타내는 비율입니다."
    },
    {
      "name": "방산",
      "desc": "군사 장비·무기와 관련 기술·서비스를 공급하는 방위산업입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "단조",
      "desc": "금속을 두드리거나 압력을 가해 모양을 만드는 가공입니다."
    },
    {
      "name": "밸브",
      "desc": "배관 속 유체의 흐름·방향·압력을 제어하는 부품입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "API",
      "desc": "소프트웨어끼리 정해진 방식으로 기능·데이터를 주고받는 연결 규칙입니다."
    },
    {
      "name": "베어링",
      "desc": "회전하는 축 등을 지지하고 마찰을 줄이는 부품입니다."
    },
    {
      "name": "열처리",
      "desc": "재료를 정해진 온도로 가열·냉각해 성질을 바꾸는 공정입니다."
    }
  ],
