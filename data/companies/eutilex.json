  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "임상",
      "desc": "사람을 대상으로 의약품 등의 안전성과 효과를 평가하는 시험입니다."
    },
    {
      "name": "항체",
      "desc": "특정 표적에 결합하는 단백질로, 의약품의 치료·전달 기술에도 쓰입니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "계속기업",
      "desc": "회사가 가까운 장래에 사업을 계속한다는 회계상 전제입니다. 관련 불확실성 표시는 적정 감사의견과 별개일 수 있습니다."
    },
    {
      "name": "용역",
      "desc": "제품 판매와 달리 공정 개발·분석·작업 등 서비스를 제공하는 사업입니다."
    },
    {
      "name": "CAR-T",
      "desc": "면역세포인 T세포가 암 표적을 인식하도록 유전적으로 바꾼 치료 기술입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
  ],
