  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "열교환기",
      "desc": "서로 다른 유체 사이에 열을 전달하여 가열하거나 냉각하는 설비입니다."
    },
    {
      "name": "배열회수보일러",
      "desc": "발전 설비 등의 뜨거운 배기가스에서 열을 회수해 증기를 만드는 설비입니다."
    },
    {
      "name": "복수기",
      "desc": "사용한 증기를 냉각해 물로 되돌리는 발전 설비입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "터빈",
      "desc": "증기·가스 등의 흐름으로 회전하여 동력을 만드는 장치입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "수주잔고",
      "desc": "받은 주문 중 아직 매출·납품으로 완료하지 않은 금액입니다."
    },
    {
      "name": "HRSG",
      "desc": "배열회수보일러로, 가스터빈 등에서 배출된 열을 회수해 증기를 만드는 설비입니다."
    },
    {
      "name": "탈기기",
      "desc": "물 속의 용존 가스 등을 제거하는 설비입니다."
    }
