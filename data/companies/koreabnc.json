  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "보툴리눔 톡신",
      "desc": "신경과 근육 사이의 신호 전달을 일시적으로 억제하는 성분을 활용한 의약품입니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "필러",
      "desc": "피부 등의 부위에 볼륨을 보충하는 시술용 재료입니다. 치과 소재에서는 레진 등을 채우고 성질을 개선하는 입자 재료를 뜻하기도 합니다."
    },
    {
      "name": "히알루론산",
      "desc": "수분을 붙잡는 성질을 가진 물질로, 피부 필러·의약품·화장품 등에 사용됩니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "콜라겐",
      "desc": "피부·뼈 등 조직을 구성하는 단백질로, 의료용 재료와 화장품 등에 활용됩니다."
    },
    {
      "name": "유착방지재",
      "desc": "수술 후 서로 붙지 않아야 할 조직이 붙는 현상을 줄이기 위한 의료용 재료입니다."
    },
    {
      "name": "창상피복재",
      "desc": "상처 부위를 덮어 보호하고 회복 환경을 유지하는 의료용 재료입니다."
    }
  ],
