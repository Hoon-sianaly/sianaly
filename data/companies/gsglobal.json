  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "거래액",
      "desc": "서비스를 통해 거래된 전체 금액입니다. 회사가 그중 수수료 등으로 인식하는 매출과는 다릅니다."
    },
    {
      "name": "대금 회수",
      "desc": "상품이나 서비스를 제공한 뒤 고객에게 받을 돈을 실제로 받는 것입니다."
    },
    {
      "name": "태양광",
      "desc": "햇빛을 태양전지 등으로 전기에너지로 바꾸는 발전 방식입니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "이익률",
      "desc": "매출 등 수익에 비해 이익이 얼마나 남는지 나타내는 비율입니다. 어떤 이익을 사용했는지 구분해야 합니다."
    },
    {
      "name": "수주",
      "desc": "고객의 주문·공사·납품 계약을 확보하는 것입니다. 실제 매출·이익과 발생 시점이 다를 수 있습니다."
    },
    {
      "name": "바이오매스",
      "desc": "나무·농업 부산물 등 생물에서 나온 자원으로, 연료·소재 등에 사용합니다."
    }
  ],
