  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "냉연",
      "desc": "금속을 상온에 가까운 상태에서 압연해 두께·표면 등을 가공하는 공정입니다."
    },
    {
      "name": "형강",
      "desc": "단면이 일정한 형태로 가공된 강재로, 건물과 산업 구조물 등에 쓰입니다."
    },
    {
      "name": "강관",
      "desc": "철강을 관 형태로 만든 제품입니다. 건설·기계·배관 등에 쓰입니다."
    },
    {
      "name": "강판",
      "desc": "철강을 판 모양으로 가공한 소재입니다. 강관·자동차 부품 등 여러 제품의 원료로 사용합니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "대금 회수",
      "desc": "상품이나 서비스를 제공한 뒤 고객에게 받을 돈을 실제로 받는 것입니다."
    },
    {
      "name": "열연",
      "desc": "금속을 높은 온도에서 눌러 판·봉 등 형태로 만드는 가공입니다."
    },
    {
      "name": "임가공",
      "desc": "고객의 원료나 반제품을 받아 가공하고 가공비를 받는 사업입니다."
    }
