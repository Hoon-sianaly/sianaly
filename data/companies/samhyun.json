  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "가동률",
      "desc": "공장·설비가 생산능력에 비해 실제로 사용된 정도입니다."
    },
    {
      "name": "모빌리티",
      "desc": "사람이나 물건의 이동과 관련된 기술·제품·서비스·사업입니다. 차량과 이동 서비스를 포함합니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "방산",
      "desc": "군사 장비·무기와 관련 기술·서비스를 공급하는 방위산업입니다."
    },
    {
      "name": "액추에이터",
      "desc": "전기 등의 에너지를 움직임으로 바꾸는 구동장치로, 로봇 관절과 이동장치 등에 사용됩니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "감속기",
      "desc": "모터 등의 회전 속도를 낮추고 필요한 회전력을 전달하는 장치입니다."
    },
    {
      "name": "밸브",
      "desc": "공기·액체 등의 흐름을 열거나 막고 조절하는 부품입니다."
    },
    {
      "name": "전장",
      "desc": "자동차 등의 전기·전자 장치와 관련 시스템을 뜻합니다."
    }
  ],
