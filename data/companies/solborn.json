  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "평가손익",
      "desc": "자산의 회계상 가치가 변하면서 발생하는 이익·손실로 실제 현금 회수와 다를 수 있습니다."
    },
    {
      "name": "벤처투자",
      "desc": "성장 가능성이 있는 초기·신생 기업 등에 자금을 투자하는 사업입니다."
    },
    {
      "name": "지주회사",
      "desc": "다른 회사의 지분을 보유·관리하는 것을 주된 역할로 하는 회사입니다. 법적 요건과 사실상 지주 기능은 구분될 수 있습니다."
    },
    {
      "name": "내부회계관리제도",
      "desc": "회사가 신뢰할 수 있는 재무정보를 작성하도록 마련한 내부 통제 체계입니다. 이에 대한 감사의견과 재무제표 감사의견은 구분됩니다."
    },
    {
      "name": "적정",
      "desc": "감사인이 재무제표가 회계기준에 따라 중요하게 왜곡되지 않았다고 판단한 의견입니다. 투자 안전이나 미래 이익을 보증하는 뜻은 아닙니다."
    },
    {
      "name": "부적정",
      "desc": "감사 대상에 중요한 문제가 광범위하게 있다고 판단한 의견입니다. 이 페이지에서는 재무제표와 내부회계관리제도 중 어느 대상인지 함께 표시합니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "투자조합",
      "desc": "여러 출자자의 자금을 모아 기업 등에 투자하고 수익을 배분하는 투자기구입니다."
    },
    {
      "name": "PACS",
      "desc": "병원의 의료영상을 저장하고 조회·전송하는 전산 시스템입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
  ],
