  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "OLED",
      "desc": "전류를 흘리면 유기 발광 재료가 스스로 빛을 내는 디스플레이 기술입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "디스플레이",
      "desc": "정보나 영상을 보여주는 화면 장치 또는 화면 패널을 뜻합니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "전처리",
      "desc": "주요 가공에 들어가기 전에 원료를 정제·분리 등 방법으로 준비하는 작업입니다."
    },
    {
      "name": "검수",
      "desc": "납품한 제품·장비가 계약 조건에 맞는지 고객이 확인하는 절차입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "증착",
      "desc": "재료를 표면에 얇은 막 형태로 쌓는 공정입니다."
    },
    {
      "name": "플라즈마",
      "desc": "기체가 에너지를 받아 전기를 띤 입자로 나뉜 상태로, 반도체 처리·가스 분해 등에 활용됩니다."
    },
    {
      "name": "식각",
      "desc": "반도체 등의 공정에서 필요한 모양을 만들기 위해 일부 재료를 제거하는 작업입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "박막",
      "desc": "표면에 매우 얇게 형성한 물질의 층입니다."
    }
  ],
