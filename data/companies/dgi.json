  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "ODM",
      "desc": "제품 개발·설계부터 생산까지 맡아 고객 브랜드로 공급하는 방식입니다."
    },
    {
      "name": "OEM",
      "desc": "고객의 상표로 제품을 대신 생산하는 방식입니다."
    },
    {
      "name": "신재생에너지",
      "desc": "태양광·풍력 등 재생 가능한 에너지와 관련 신에너지 기술을 포함하는 분야입니다."
    },
    {
      "name": "검수",
      "desc": "납품한 제품·장비가 계약 조건에 맞는지 고객이 확인하는 절차입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "용역",
      "desc": "제품 판매와 달리 공정 개발·분석·작업 등 서비스를 제공하는 사업입니다."
    },
    {
      "name": "EPC",
      "desc": "설계·조달·시공을 함께 수행하는 사업 방식입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "DVR",
      "desc": "카메라 영상을 디지털 방식으로 기록하는 장치입니다."
    },
    {
      "name": "NVR",
      "desc": "네트워크 카메라 영상을 받아 저장하는 장치입니다."
    }
  ],
