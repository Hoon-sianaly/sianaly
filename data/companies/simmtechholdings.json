    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "가동률",
      "desc": "공장·설비가 생산능력에 비해 실제로 사용된 정도입니다."
    },
    {
      "name": "수율",
      "desc": "투입하거나 생산한 제품 중 규격을 충족한 양품의 비율입니다."
    },
    {
      "name": "차입",
      "desc": "은행 대출이나 채권 발행 등으로 외부에서 돈을 빌리는 것입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "패키지 기판",
      "desc": "반도체 칩을 지지하고 칩과 외부 회로를 전기적으로 연결하는 기판입니다."
    },
    {
      "name": "PCB",
      "desc": "인쇄회로기판으로 전자부품을 지지하고 전기 신호를 연결하는 기판입니다."
    },
    {
      "name": "지주회사",
      "desc": "다른 회사의 주식을 보유해 계열사를 지배·관리하는 회사입니다. 자체 사업을 함께 운영하기도 합니다."
    },
    {
      "name": "임가공",
      "desc": "고객의 원료나 반제품을 받아 가공하고 가공비를 받는 사업입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
