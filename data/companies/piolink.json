  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "데이터센터",
      "desc": "서버·저장장치·네트워크 장비와 이를 운영할 전력·냉각 설비를 모아 놓은 시설입니다."
    },
    {
      "name": "ADC",
      "desc": "항체에 약물을 연결해 특정 표적에 전달하도록 설계한 항체약물접합체입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "보안관제",
      "desc": "정보시스템의 침해 시도를 감시·분석하고 대응하는 서비스입니다."
    },
    {
      "name": "방화벽",
      "desc": "허용 규칙에 따라 네트워크 통신을 통제하는 보안 장치·소프트웨어입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "스위치",
      "desc": "통신망에서 데이터를 필요한 연결 경로로 전달하는 장비입니다. 전기 제품에서는 전원을 켜고 끄는 부품을 뜻하기도 합니다."
    }
  ],
