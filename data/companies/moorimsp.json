    },
    {
      "name": "수지",
      "desc": "플라스틱·접착제·도료 등을 만드는 고분자 재료를 뜻합니다."
    },
    {
      "name": "펄프",
      "desc": "목재 등의 섬유질을 분리해 만든 종이의 주원료입니다."
    },
    {
      "name": "코팅",
      "desc": "소재 표면에 다른 물질을 얇게 입히는 공정입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "CCP",
      "desc": "표면을 매끄럽고 광택 있게 처리한 코팅 종이로 포장 등에 쓰입니다."
    },
    {
      "name": "백상지",
      "desc": "책·노트·문서 인쇄 등에 쓰는 일반적인 비코팅 종이입니다."
    },
    {
      "name": "아트지",
      "desc": "표면을 코팅해 사진·색상 인쇄가 잘 되도록 만든 종이입니다."
    }
