  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "임상",
      "desc": "사람을 대상으로 의약품 등의 안전성과 효과를 평가하는 시험입니다."
    },
    {
      "name": "기술이전",
      "desc": "개발 기술이나 권리를 다른 회사에 제공하고 계약금·단계별 대금 등을 받는 계약입니다."
    },
    {
      "name": "항체",
      "desc": "특정 항원에 결합하는 단백질로, 진단과 의약품 등에서 활용됩니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "이중항체",
      "desc": "서로 다른 두 표적을 인식하도록 설계한 항체 기술입니다."
    },
    {
      "name": "용역",
      "desc": "제품 판매와 달리 공정 개발·분석·작업 등 서비스를 제공하는 사업입니다."
    },
    {
      "name": "CAR-T",
      "desc": "면역세포에 암세포 표적을 인식하는 기능을 부여해 개발하는 세포치료제 기술입니다."
    },
    {
      "name": "NEST",
      "desc": "앱클론이 항체 신약 후보를 발굴·개발하는 기반 기술의 명칭입니다."
    },
    {
      "name": "AffiMab",
      "desc": "앱클론의 이중항체 신약 개발 플랫폼 명칭입니다."
    },
    {
      "name": "AT101",
      "desc": "앱클론이 혈액암 등을 대상으로 개발하는 CAR-T 치료제 후보 명칭입니다."
    }
