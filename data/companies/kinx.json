    },
    {
      "name": "라이선스",
      "desc": "기술·소프트웨어·콘텐츠 등을 정해진 조건으로 사용할 수 있는 권리·계약입니다."
    },
    {
      "name": "클라우드",
      "desc": "서버·저장·소프트웨어 등의 자원을 네트워크로 이용하는 서비스 방식입니다."
    },
    {
      "name": "데이터센터",
      "desc": "서버·저장장치·네트워크 장비와 이를 운영할 전력·냉각 설비를 모아 놓은 시설입니다."
    },
    {
      "name": "감가상각",
      "desc": "설비·장비 등의 취득 비용을 사용 기간에 걸쳐 나누어 비용으로 반영하는 것입니다."
    },
    {
      "name": "소프트웨어",
      "desc": "컴퓨터·장치가 작업을 수행하도록 하는 프로그램입니다."
    },
    {
      "name": "콘텐츠",
      "desc": "영상·음악·공연·글 등 이용자에게 제공하는 창작물과 정보입니다."
    },
    {
      "name": "CDN",
      "desc": "콘텐츠를 여러 서버에 분산해 이용자에게 빠르고 안정적으로 전달하는 서비스입니다."
    },
    {
      "name": "IX",
      "desc": "서로 다른 인터넷망이 데이터를 교환하도록 연결하는 서비스·체계입니다."
    },
    {
      "name": "코로케이션",
      "desc": "데이터센터의 공간·전력·망을 빌려 고객 서버를 설치·운용하는 서비스입니다."
    }
