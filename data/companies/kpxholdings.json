  "overview": {
    "short": "KPX홀딩스는 화학 소재 계열사를 중심으로 여러 사업을 관리하는 지주회사",
    "summary": "KPX홀딩스는 화학 소재 계열사를 중심으로 여러 사업을 관리하는 지주회사입니다. KPX케미칼 등 계열사의 폴리우레탄 원료·전자재료 사업이 연결 범위에 포함됩니다.",
    "takeaways": [
      "KPX홀딩스는 화학 소재 계열사를 중심으로 여러 사업을 관리하는 지주회사입니다.",
      "KPX케미칼 등 계열사의 폴리우레탄 원료·전자재료 사업이 연결 범위에 포함됩니다.",
      "화학 소재 외에 계열사의 자동차 부품과 부동산 임대 사업도 있습니다.",
      "화학제품 가격과 원료 비용의 차이, 자동차·전자·건설 고객의 수요가 중요합니다.",
      "상장 계열사와 연결 실적이 겹칠 수 있으므로 각 회사 매출을 단순히 더하지 않습니다."
    ],
    "business": [
      {
        "name": "화학 원료·전자재료",
        "desc": "KPX케미칼 등 계열사에서 폴리우레탄 관련 원료와 전자재료를 제조·판매합니다."
      },
      {
        "name": "자동차 부품",
        "desc": "계열사를 통해 자동차 시트 등 부품을 제조하며 자동차 고객의 생산과 주문에 대응합니다."
      },
      {
        "name": "지주·부동산 임대",
        "desc": "계열사 투자·관리를 수행하고 연결 대상의 부동산 임대 사업도 반영합니다."
      }
    ],
    "drivers": [
      {
        "title": "원료와 제품 가격",
        "desc": "원료비 상승을 제품 가격에 반영하는 정도와 화학제품 판매 물량을 함께 확인합니다."
      },
      {
        "title": "고객 산업별 수요",
        "desc": "자동차·전자·건설의 생산·투자 변화가 서로 다른 소재·부품 사업에 영향을 줍니다."
      },
      {
        "title": "연결과 개별 실적",
        "desc": "지주회사 자체의 배당·관리 수익과 자회사 포함 연결 실적은 범위가 다릅니다."
      }
