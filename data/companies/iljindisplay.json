    {
      "name": "중단사업",
      "desc": "매각하거나 종료하는 등 회계기준상 별도로 구분하는 사업입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "중단영업",
      "desc": "매각·종료 등을 이유로 계속하는 사업과 별도로 표시하는 영업입니다."
    },
    {
      "name": "계속기업",
      "desc": "회사가 가까운 미래에도 영업을 계속한다는 회계상 전제입니다. 중요한 불확실성이 있으면 관련 공시를 확인해야 합니다."
    },
    {
      "name": "적정",
      "desc": "감사인이 재무제표가 회계기준에 따라 중요하게 왜곡되지 않았다고 판단한 의견입니다. 투자 안전이나 미래 이익을 보증하는 뜻은 아닙니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "터치스크린패널",
      "desc": "손가락·펜 등의 접촉 위치를 감지해 기기에 전달하는 입력 부품입니다."
    },
    {
      "name": "사파이어 웨이퍼",
      "desc": "인공 사파이어를 얇은 판으로 만든 소재입니다. LED 등의 제조 기판으로 사용합니다."
    },
    {
      "name": "전장",
      "desc": "자동차 등의 전기·전자 장치와 관련 시스템을 뜻합니다."
