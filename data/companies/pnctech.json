  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "배전",
      "desc": "송전망에서 받은 전기를 지역의 가정·공장 등 사용자에게 나눠 공급하는 과정입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "전력망",
      "desc": "발전소에서 생산한 전기를 고객에게 전달하는 송전·변전·배전 설비의 연결 체계입니다."
    },
    {
      "name": "계측",
      "desc": "온도·압력 등 설비 상태나 물리량을 장치로 측정하는 일입니다."
    },
    {
      "name": "단말",
      "desc": "이용자가 통신망·서비스에 접속하기 위해 사용하는 장치입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "배전자동화",
      "desc": "전기를 나눠 공급하는 배전망의 상태 감시·제어를 자동화하는 기술입니다."
    },
    {
      "name": "보호계전기",
      "desc": "전력 설비의 이상을 감지해 차단 등 보호 동작을 지시하는 기기입니다."
    }
