  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "OLED",
      "desc": "전류를 흘리면 유기 발광 재료가 스스로 빛을 내는 디스플레이 기술입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "디스플레이",
      "desc": "정보나 영상을 보여주는 화면 장치 또는 화면 패널을 뜻합니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "드라이아이스",
      "desc": "이산화탄소를 고체로 만든 냉각 소재입니다."
    },
    {
      "name": "증착",
      "desc": "반도체 기판 등에 필요한 물질을 얇은 막 형태로 쌓는 제조 공정입니다."
    },
    {
      "name": "포토마스크",
      "desc": "반도체·디스플레이 회로의 모양을 빛으로 전달하기 위한 원판입니다."
    },
    {
      "name": "유기재료",
      "desc": "탄소를 포함하는 화합물 계열로, OLED에서는 빛을 내거나 전하를 이동시키는 소재입니다."
    },
    {
      "name": "고순도",
      "desc": "불순물의 함량이 매우 낮은 상태로, 공정별 요구 수준이 다릅니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "박막",
      "desc": "표면에 매우 얇게 형성한 물질의 층입니다."
    },
    {
      "name": "프리커서",
      "desc": "공정에서 원하는 막이나 물질을 만들 때 화학반응에 사용하는 출발 원료입니다."
    }
  ],
