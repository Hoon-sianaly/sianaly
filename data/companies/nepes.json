  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "가동률",
      "desc": "공장·설비가 생산능력에 비해 실제로 사용된 정도입니다."
    },
    {
      "name": "수율",
      "desc": "투입·생산한 제품 중 정상적으로 사용할 수 있는 제품의 비율입니다."
    },
    {
      "name": "차입",
      "desc": "은행 대출이나 채권 발행 등으로 외부에서 돈을 빌리는 것입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "감가상각",
      "desc": "설비·장비 등의 취득 비용을 사용 기간에 걸쳐 나누어 비용으로 반영하는 것입니다."
    },
    {
      "name": "패키징",
      "desc": "반도체 칩을 보호하고 외부 회로와 연결할 수 있도록 조립하는 과정입니다."
    },
    {
      "name": "디스플레이",
      "desc": "정보나 영상을 보여주는 화면 장치 또는 화면 패널을 뜻합니다."
    },
    {
      "name": "전자재료",
      "desc": "반도체·디스플레이 등 전자제품의 제조와 기능 구현에 사용하는 소재입니다."
    },
    {
      "name": "후공정",
      "desc": "만들어진 반도체 칩을 조립·포장·검사하는 단계입니다."
    },
    {
      "name": "식각",
      "desc": "필요 없는 부분을 선택적으로 제거해 회로 등의 모양을 만드는 공정입니다."
    },
    {
      "name": "리드탭",
      "desc": "배터리 내부 전극과 외부 회로를 연결하는 금속 단자 부품입니다."
    },
    {
      "name": "범핑",
      "desc": "칩과 기판을 연결할 미세한 돌기형 접점을 만드는 공정입니다."
    }
