  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "수율",
      "desc": "투입·생산한 제품 중 정상적으로 사용할 수 있는 제품의 비율입니다."
    },
    {
      "name": "전구체",
      "desc": "다른 소재로 전환되기 전 단계의 물질입니다. 반도체 증착 원료나 배터리 양극재 원료 등을 뜻할 수 있습니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "태양광",
      "desc": "햇빛을 태양전지 등으로 전기에너지로 바꾸는 발전 방식입니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "증착",
      "desc": "반도체 기판 등에 필요한 물질을 얇은 막 형태로 쌓는 제조 공정입니다."
    },
    {
      "name": "ALD",
      "desc": "원자층 증착으로, 표면 반응을 반복해 매우 얇고 균일한 막을 만드는 공정입니다."
    },
    {
      "name": "메탈로센",
      "desc": "특정 구조의 금속 화합물 계열로, 고분자 등을 만드는 촉매에 활용됩니다."
    }
  ],
