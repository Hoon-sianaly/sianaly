  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "계속기업",
      "desc": "회사가 가까운 장래에도 사업을 이어갈 것이라는 회계상 전제입니다. 중요한 불확실성이 있으면 공시·감사 보고서를 함께 확인해야 합니다."
    },
    {
      "name": "의견거절",
      "desc": "감사인이 충분한 근거를 확보하지 못하는 등 이유로 재무제표에 감사의견을 표명하지 않은 상태입니다."
    },
    {
      "name": "내부회계관리제도",
      "desc": "재무정보를 신뢰할 수 있게 작성하기 위한 회사의 절차와 통제 체계입니다. 제도에 대한 감사의견과 재무제표 감사의견은 서로 다릅니다."
    },
    {
      "name": "적정",
      "desc": "감사인이 재무제표가 회계기준에 따라 중요하게 왜곡되지 않았다고 판단한 의견입니다. 투자 안전이나 미래 이익을 보증하는 뜻은 아닙니다."
    },
    {
      "name": "유동성",
      "desc": "가까운 시일에 필요한 돈이나 지급 의무를 감당할 수 있는 능력입니다."
    }
  ],
