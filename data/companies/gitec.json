    {
      "name": "솔루션",
      "desc": "특정 업무나 문제를 해결하기 위해 제공하는 제품·기술·서비스의 묶음입니다."
    },
    {
      "name": "디스플레이",
      "desc": "정보나 영상을 보여주는 화면 장치 또는 화면 패널을 뜻합니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "코팅",
      "desc": "소재 표면에 다른 물질을 얇게 입히는 공정입니다."
    },
    {
      "name": "머신비전",
      "desc": "카메라 영상과 소프트웨어로 제품의 형상·결함 등을 측정·판단하는 기술입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "노즐",
      "desc": "물·기체 등을 정해진 방향과 양으로 분사하는 부분입니다."
    },
    {
      "name": "전극",
      "desc": "배터리에서 전류가 드나들며 충전·방전에 관여하는 부분입니다."
    },
    {
      "name": "슬롯다이",
      "desc": "좁은 틈으로 액체를 내보내 얇고 균일하게 펴 바르는 정밀 부품입니다."
