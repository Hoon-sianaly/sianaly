  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "태양광",
      "desc": "햇빛을 태양전지 등으로 전기에너지로 바꾸는 발전 방식입니다."
    },
    {
      "name": "필름",
      "desc": "얇은 막 형태의 소재로, 포장재와 전자 부품 등의 재료로 사용합니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "임가공",
      "desc": "고객이 맡긴 재료나 제품을 대신 가공하는 일입니다."
    },
    {
      "name": "방청",
      "desc": "금속에 녹이 생기는 것을 줄이거나 막는 기능입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "PE",
      "desc": "폴리에틸렌의 약자로 포장 필름 등 다양한 제품의 원료가 되는 플라스틱입니다."
    },
    {
      "name": "LDPE",
      "desc": "밀도가 낮은 폴리에틸렌으로 필름·포장재 등에 쓰입니다."
    },
    {
      "name": "HDPE",
      "desc": "밀도가 높은 폴리에틸렌으로 용기·산업용 소재 등에 쓰입니다."
    }
  ],
