  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "강판",
      "desc": "철강을 판 모양으로 가공한 소재입니다. 강관·자동차 부품 등 여러 제품의 원료로 사용합니다."
    },
    {
      "name": "태양광",
      "desc": "햇빛을 태양전지 등으로 전기에너지로 바꾸는 발전 방식입니다."
    },
    {
      "name": "컬러강판",
      "desc": "강판 표면에 색상·무늬와 보호 기능을 가진 도료를 입힌 제품입니다."
    },
    {
      "name": "도료",
      "desc": "표면에 발라 색·보호 기능 등을 주는 재료로, 페인트 등이 포함됩니다."
    },
    {
      "name": "내부회계관리제도",
      "desc": "재무정보를 신뢰할 수 있게 작성하기 위한 회사의 절차와 통제 체계입니다. 제도에 대한 감사의견과 재무제표 감사의견은 서로 다릅니다."
    },
    {
      "name": "적정",
      "desc": "감사인이 재무제표가 회계기준에 따라 중요하게 왜곡되지 않았다고 판단한 의견입니다. 투자 안전이나 미래 이익을 보증하는 뜻은 아닙니다."
    },
    {
      "name": "부적정",
      "desc": "감사 대상에 중요한 문제가 광범위하게 있다고 판단한 의견입니다. 이 페이지에서는 재무제표와 내부회계관리제도 중 어느 대상인지 함께 표시합니다."
    }
  ],
