  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "라이선스",
      "desc": "브랜드·기술·콘텐츠 등의 권리를 계약 조건에 따라 사용할 수 있는 허락입니다."
    },
    {
      "name": "모빌리티",
      "desc": "사람이나 물건의 이동과 관련된 기술·제품·서비스·사업입니다. 차량과 이동 서비스를 포함합니다."
    },
    {
      "name": "리스",
      "desc": "회사 등이 구입한 자산을 고객이 일정 기간 사용하고 사용료를 내는 방식입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "태양광",
      "desc": "햇빛을 태양전지 등으로 전기에너지로 바꾸는 발전 방식입니다."
    },
    {
      "name": "플랫폼",
      "desc": "여러 기술·제품·서비스를 제공하거나 개발하는 공통 기반입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "금형",
      "desc": "같은 모양의 제품을 반복 생산하기 위해 사용하는 틀입니다."
    },
    {
      "name": "차체",
      "desc": "자동차의 골격·외형을 이루는 구조를 뜻합니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
