  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "차입",
      "desc": "은행 대출이나 채권 발행 등으로 외부에서 돈을 빌리는 것입니다."
    },
    {
      "name": "물동량",
      "desc": "일정 기간에 운송하거나 처리한 화물의 양입니다."
    },
    {
      "name": "운임",
      "desc": "사람이나 화물을 운송하는 대가로 받는 요금입니다."
    },
    {
      "name": "지주회사",
      "desc": "다른 회사의 주식을 보유해 계열사를 지배·관리하는 회사입니다. 자체 사업을 함께 운영하기도 합니다."
    },
    {
      "name": "현금 흐름",
      "desc": "일정 기간 실제로 들어오고 나가는 돈의 움직임입니다. 회계상 이익과 다를 수 있습니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "육가공",
      "desc": "육류를 가공해 햄·소시지 등 식품을 만드는 사업이나 공정입니다."
    },
    {
      "name": "배당",
      "desc": "회사가 정해진 절차에 따라 주주에게 나누어 지급하는 돈이나 주식입니다."
    }
  ],
