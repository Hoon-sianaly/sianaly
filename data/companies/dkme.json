  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "플랜트",
      "desc": "제품을 생산하거나 에너지·환경 처리를 수행하는 산업 설비입니다."
    },
    {
      "name": "열교환기",
      "desc": "서로 다른 유체 사이에 열을 전달하여 가열하거나 냉각하는 설비입니다."
    },
    {
      "name": "강관",
      "desc": "철강으로 만든 관입니다. 물·가스 등을 운반하는 배관이나 구조물을 지탱하는 재료로 사용합니다."
    },
    {
      "name": "강판",
      "desc": "철강을 판 모양으로 가공한 소재입니다. 강관·자동차 부품 등 여러 제품의 원료로 사용합니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "폐지",
      "desc": "사용 후 회수한 종이로, 제지업의 재활용 원료로 사용합니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "내부회계관리제도",
      "desc": "재무정보를 신뢰할 수 있게 작성하기 위한 회사의 절차와 통제 체계입니다. 제도에 대한 감사의견과 재무제표 감사의견은 서로 다릅니다."
    },
    {
      "name": "적정",
      "desc": "감사인이 재무제표가 회계기준에 따라 중요하게 왜곡되지 않았다고 판단한 의견입니다. 투자 안전이나 미래 이익을 보증하는 뜻은 아닙니다."
    },
    {
      "name": "부적정",
      "desc": "감사 대상에 중요한 문제가 광범위하게 있다고 판단한 의견입니다. 이 페이지에서는 재무제표와 내부회계관리제도 중 어느 대상인지 함께 표시합니다."
    },
    {
      "name": "감사 강조사항",
      "desc": "감사인이 이용자의 주의를 끌기 위해 따로 설명한 사항입니다. 재무제표 감사의견 변경과 같은 뜻은 아닙니다."
    }
  ],
