  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "데이터센터",
      "desc": "서버·저장장치·네트워크 장비와 이를 운영할 전력·냉각 설비를 모아 놓은 시설입니다."
    },
    {
      "name": "플랜트",
      "desc": "제품을 생산하거나 에너지·환경 처리를 수행하는 산업 설비입니다."
    },
    {
      "name": "솔루션",
      "desc": "특정 업무나 문제를 해결하기 위해 제공하는 제품·기술·서비스의 묶음입니다."
    },
    {
      "name": "클린룸",
      "desc": "먼지 등 오염 물질을 정밀하게 제어하는 생산 공간으로, 반도체 등 제조에 쓰입니다."
    },
    {
      "name": "드라이룸",
      "desc": "습도를 낮게 유지하는 생산 공간으로, 배터리 등 습기에 민감한 제품 제조에 쓰입니다."
    },
    {
      "name": "공조",
      "desc": "공기의 온도·습도·청정도 등을 제어하는 설비나 운용을 뜻합니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "디스플레이",
      "desc": "정보나 영상을 보여주는 화면 장치 또는 화면 패널을 뜻합니다."
    },
    {
      "name": "대금 회수",
      "desc": "상품이나 서비스를 제공한 뒤 고객에게 받을 돈을 실제로 받는 것입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    }
