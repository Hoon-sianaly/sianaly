  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "수율",
      "desc": "투입·생산한 물량 중 정상 제품으로 완성되는 비율입니다."
    },
    {
      "name": "모빌리티",
      "desc": "사람이나 물건의 이동과 관련된 기술·제품·서비스·사업입니다. 차량과 이동 서비스를 포함합니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "방산",
      "desc": "군사 장비·무기와 관련 기술·서비스를 공급하는 방위산업입니다."
    },
    {
      "name": "배전",
      "desc": "송전망에서 받은 전기를 지역의 가정·공장 등 사용자에게 나눠 공급하는 과정입니다."
    },
    {
      "name": "인버터",
      "desc": "전력을 변환하거나 주파수 등을 조절해 모터·장비를 제어하는 장치입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "신재생에너지",
      "desc": "태양광·풍력 등 재생 가능한 에너지와 관련 신에너지 기술을 포함하는 분야입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "컨버터",
      "desc": "전압 수준이나 전기의 형태 등을 바꾸는 전력변환 장치입니다."
    },
    {
      "name": "정류기",
      "desc": "교류를 직류로 바꾸는 전원 장치입니다."
    }
  ],
