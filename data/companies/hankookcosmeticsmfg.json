  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "가동률",
      "desc": "공장이나 설비가 생산 가능한 능력 중 실제로 사용하는 비율입니다."
    },
    {
      "name": "ODM",
      "desc": "생산사가 제품을 직접 연구·개발하고 고객 브랜드 이름으로 제조·공급하는 방식입니다."
    },
    {
      "name": "OEM",
      "desc": "고객이 주문한 사양에 맞춰 제품을 제조하고 고객 브랜드로 공급하는 방식입니다."
    },
    {
      "name": "색조 화장품",
      "desc": "피부·입술 등에 색이나 외관 효과를 더하는 화장품입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "재고 조정",
      "desc": "보유 상품·원료가 많거나 적을 때 주문·생산 등을 바꿔 재고 수준을 맞추는 과정입니다."
    },
    {
      "name": "이익률",
      "desc": "매출 등 수익에 비해 이익이 얼마나 남는지 나타내는 비율입니다. 어떤 이익을 사용했는지 구분해야 합니다."
    }
  ],
