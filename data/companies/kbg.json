  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "폴리머",
      "desc": "작은 분자가 반복적으로 결합한 고분자로, 플라스틱 등 여러 소재의 바탕이 됩니다."
    },
    {
      "name": "단열",
      "desc": "열이 이동하는 것을 줄이는 성질·작업입니다."
    },
    {
      "name": "방열",
      "desc": "장치에서 발생한 열을 바깥으로 내보내는 기능입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "기능성",
      "desc": "일반 제품의 기본 용도에 더해 특정 성능이나 사용 목적에 맞춘 특성을 뜻합니다."
    },
    {
      "name": "실리콘",
      "desc": "규소 기반 소재로, 반도체 칩과 제조장비 부품 등에 사용합니다."
    },
    {
      "name": "코팅",
      "desc": "소재 표면에 다른 물질을 얇게 입히는 공정입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "레진",
      "desc": "치과 충전재 등에 쓰는 수지 계열 재료입니다."
    },
    {
      "name": "실란",
      "desc": "실리콘계 화학 소재의 한 종류로 접착·코팅 등 소재 제조에 활용됩니다."
    },
    {
      "name": "에어로젤",
      "desc": "미세한 구멍이 많은 가벼운 다공성 소재로 단열 등에 쓰입니다."
    }
  ],
