    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "솔루션",
      "desc": "특정 업무나 문제를 해결하기 위해 제공하는 제품·기술·서비스의 묶음입니다."
    },
    {
      "name": "플랫폼",
      "desc": "여러 제품·기술을 개발하거나 서비스를 제공하는 데 활용하는 공통 기반입니다."
    },
    {
      "name": "키오스크",
      "desc": "사용자가 화면 등을 직접 조작해 주문·결제·환전 등을 수행하는 무인 단말기입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "메시징",
      "desc": "문자나 메시지를 전달·처리하는 서비스와 시스템입니다."
    },
    {
      "name": "ERP",
      "desc": "회계·인사·구매 등 기업 업무 정보를 통합 관리하는 시스템입니다."
    },
    {
      "name": "가상계좌",
      "desc": "고객·거래별로 부여해 입금 내역을 식별하는 데 쓰는 계좌번호입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "정산",
      "desc": "거래 후 받을 돈과 지급할 돈을 계산해 실제로 지급하는 과정입니다."
