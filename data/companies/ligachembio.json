  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "임상",
      "desc": "사람을 대상으로 의약품 등의 안전성과 효과를 확인하는 연구 단계입니다."
    },
    {
      "name": "기술이전",
      "desc": "개발한 기술을 다른 회사가 사용·개발·판매할 수 있도록 권리를 넘기거나 허용하는 계약입니다."
    },
    {
      "name": "항체",
      "desc": "특정 항원에 결합하는 단백질로, 진단과 의약품 등에서 활용됩니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "소모품",
      "desc": "기기 사용 과정에서 소진돼 교체·보충하는 재료입니다. 인쇄용 토너 등이 해당합니다."
    },
    {
      "name": "플랫폼",
      "desc": "여러 제품·기술을 개발하거나 서비스를 제공하는 데 활용하는 공통 기반입니다. 여기서는 약물 전달 등 기술 기반을 뜻합니다."
    },
    {
      "name": "ADC",
      "desc": "항체약물접합체로, 항체와 약물을 연결해 특정 표적에 전달하도록 개발하는 의약품 기술입니다."
    },
    {
      "name": "항체약물접합체",
      "desc": "항체와 약물을 연결해 특정 표적에 전달하도록 개발하는 의약품·기술입니다."
    },
    {
      "name": "마일스톤",
      "desc": "임상 진전·허가·판매 등 계약에 정한 단계별 조건을 달성하면 받는 대금입니다. 전체 계약 금액이 한 번에 매출이 되는 것은 아닙니다."
    }
  ],
