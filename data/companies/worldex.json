  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "가동률",
      "desc": "공장·설비가 생산능력에 비해 실제로 사용된 정도입니다."
    },
    {
      "name": "수율",
      "desc": "투입·생산한 제품 중 정상적으로 사용할 수 있는 제품의 비율입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "소모품",
      "desc": "기기 사용 과정에서 소진돼 교체·보충하는 재료입니다. 인쇄용 토너 등이 해당합니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "SiC",
      "desc": "탄화규소로, 열과 마모 등에 강한 특성을 활용해 반도체 공정용 부품 등에 사용합니다."
    },
    {
      "name": "식각",
      "desc": "필요 없는 부분을 선택적으로 제거해 회로 등의 모양을 만드는 공정입니다."
    },
    {
      "name": "실리콘",
      "desc": "규소 기반 소재로, 반도체 칩과 제조장비 부품 등에 사용합니다."
    },
    {
      "name": "소모성",
      "desc": "사용 과정에서 마모·소진되어 주기적인 교체가 필요한 성질입니다."
    },
    {
      "name": "쿼츠",
      "desc": "석영을 뜻하며 고순도·내열 특성을 활용해 반도체 장비 부품 등에 사용합니다."
    },
    {
      "name": "세라믹",
      "desc": "금속·플라스틱과 다른 무기 소재 계열로 내열·절연 특성 등을 활용합니다."
    }
  ],
