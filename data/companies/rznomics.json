  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "임상",
      "desc": "사람을 대상으로 의약품 등의 안전성과 효과를 평가하는 시험입니다."
    },
    {
      "name": "기술이전",
      "desc": "개발 기술이나 권리를 다른 회사에 제공하고 계약금·단계별 대금 등을 받는 계약입니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "플랫폼",
      "desc": "여러 제품·기술을 개발하거나 서비스를 제공하는 데 활용하는 공통 기반입니다. 여기서는 약물 전달 등 기술 기반을 뜻합니다."
    },
    {
      "name": "마일스톤",
      "desc": "임상 진전·허가·판매 등 계약에 정한 단계별 조건을 달성하면 받는 대금입니다. 전체 계약 금액이 한 번에 매출이 되는 것은 아닙니다."
    },
    {
      "name": "RNA",
      "desc": "유전정보 전달·발현 등에 관여하는 핵산입니다."
    },
    {
      "name": "RNA 치환효소",
      "desc": "표적 RNA를 인지·절단하고 원하는 RNA를 연결하는 기능을 활용하는 신약 기술입니다."
    }
  ],
