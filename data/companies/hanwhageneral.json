  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "보험수익",
      "desc": "보험 서비스를 제공하면서 회계상 인식하는 수익입니다. 고객에게 받은 보험료 총액과는 다릅니다."
    },
    {
      "name": "지급여력",
      "desc": "보험사가 예상하지 못한 손실을 감당하고 보험금을 지급할 수 있는 재무적 능력입니다."
    },
    {
      "name": "IR",
      "desc": "회사가 투자자에게 사업·실적 등을 설명하는 활동과 자료를 뜻합니다."
    },
    {
      "name": "손해율",
      "desc": "보험회사가 보험 관련 수입에 비해 보험금 등으로 얼마나 지출했는지 나타내는 비율입니다. 상품·회계 기준에 따라 산식은 다를 수 있습니다."
    },
    {
      "name": "IFRS 17",
      "desc": "보험계약의 수익·비용·부채를 인식하고 측정하는 국제회계기준입니다. 받은 보험료 전액을 곧바로 보험수익으로 잡는 방식과 구분합니다."
    }
  ],
