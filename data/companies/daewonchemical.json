  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "가동률",
      "desc": "공장이나 설비가 생산 가능한 능력 중 실제로 사용하는 비율입니다."
    },
    {
      "name": "복합소재",
      "desc": "서로 다른 소재를 결합해 강도·무게·내열성 등의 특성을 개선한 재료입니다."
    },
    {
      "name": "피혁",
      "desc": "동물의 가죽을 가공해 만든 소재입니다."
    },
    {
      "name": "원단",
      "desc": "옷 등을 만들기 전 단계의 천으로, 의류 제조에 사용하는 재료입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "용제",
      "desc": "다른 물질을 녹이거나 도료의 점도 등을 조절하는 액체입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "합성피혁",
      "desc": "섬유 등에 합성수지를 입혀 가죽처럼 만든 소재입니다."
    },
    {
      "name": "DMF",
      "desc": "합성피혁 등의 제조 공정에서 사용하는 유기용제입니다. 사용 후 회수·정제해 다시 활용할 수 있습니다."
    },
    {
      "name": "LPMC",
      "desc": "복합소재를 낮은 압력으로 성형해 부품 등을 만드는 방식입니다."
    }
  ],
