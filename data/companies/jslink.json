  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "DNA",
      "desc": "생물체의 유전정보를 담고 있는 물질입니다."
    },
    {
      "name": "소결",
      "desc": "분말 재료에 열 등을 가해 입자를 결합하고 원하는 형태로 만드는 공정입니다."
    },
    {
      "name": "유전체",
      "desc": "생물체가 가진 유전정보 전체를 뜻합니다."
    },
    {
      "name": "바이오뱅크",
      "desc": "연구 등에 활용하는 인체유래물과 관련 정보를 수집·보관하는 시설·체계입니다."
    },
    {
      "name": "희토류",
      "desc": "자석 등 다양한 첨단 제품에 쓰이는 금속 원소군입니다."
    },
    {
      "name": "영구소결자석",
      "desc": "분말 소재를 열로 결합해 만들며 지속적인 자기력을 가지는 자석입니다."
    }
