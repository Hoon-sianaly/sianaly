  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "소프트웨어",
      "desc": "컴퓨터·장치가 작업을 수행하도록 하는 프로그램입니다."
    },
    {
      "name": "압연",
      "desc": "금속을 회전하는 롤 사이로 눌러 판·봉 등의 형태로 만드는 공정입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "검수",
      "desc": "납품한 제품·장비가 계약 조건에 맞는지 고객이 확인하는 절차입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "코팅",
      "desc": "소재 표면에 다른 물질을 얇게 입히는 공정입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "모듈",
      "desc": "특정 기능을 수행하도록 여러 부품을 결합한 구성 단위입니다."
    },
    {
      "name": "전극",
      "desc": "배터리에서 전류가 드나들며 충전·방전에 관여하는 부분입니다."
    }
  ],
