  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "대금 회수",
      "desc": "상품이나 서비스를 제공한 뒤 고객에게 받을 돈을 실제로 받는 것입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "계속기업",
      "desc": "회사가 가까운 장래에 사업을 계속한다는 회계상 전제입니다. 관련 불확실성 표시는 적정 감사의견과 별개일 수 있습니다."
    },
    {
      "name": "의견거절",
      "desc": "감사인이 충분한 근거를 얻지 못하는 등의 사유로 재무제표에 대한 감사의견을 제시하지 못한 상태입니다."
    },
    {
      "name": "적정",
      "desc": "감사인이 재무제표가 회계기준에 따라 중요하게 왜곡되지 않았다고 판단한 의견입니다. 투자 안전이나 미래 이익을 보증하는 뜻은 아닙니다."
    },
    {
      "name": "성장인자",
      "desc": "세포의 성장·분화 등에 관여하는 단백질 계열입니다."
    },
    {
      "name": "이식재",
      "desc": "손상된 신체 조직을 보완·재건하기 위해 사용하는 재료입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
