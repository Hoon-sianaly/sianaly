  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "IP",
      "desc": "지적재산을 뜻합니다. 반도체에서는 재사용 가능한 설계 블록, 콘텐츠에서는 작품·아티스트 관련 권리 등을 가리킵니다."
    },
    {
      "name": "파운드리",
      "desc": "고객이 설계한 반도체를 주문받아 제조하는 사업입니다."
    },
    {
      "name": "플랫폼",
      "desc": "여러 제품·기술을 개발하거나 서비스를 제공하는 데 활용하는 공통 기반입니다. 여기서는 약물 전달 등 기술 기반을 뜻합니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "후공정",
      "desc": "만들어진 반도체 칩을 조립·포장·검사하는 단계입니다."
    },
    {
      "name": "턴키",
      "desc": "여러 개발·생산 단계를 묶어 일괄 수행하는 계약·서비스 방식입니다."
    }
  ],
