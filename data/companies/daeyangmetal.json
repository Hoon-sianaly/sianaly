    {
      "name": "운임",
      "desc": "사람이나 화물을 운송하는 대가로 받는 요금입니다."
    },
    {
      "name": "스테인리스",
      "desc": "크롬 등을 포함해 부식에 잘 견디도록 만든 강철입니다."
    },
    {
      "name": "냉연",
      "desc": "금속을 상온에 가까운 상태에서 압연해 두께·표면 등을 가공하는 공정입니다."
    },
    {
      "name": "강판",
      "desc": "철강을 판 모양으로 가공한 소재입니다. 강관·자동차 부품 등 여러 제품의 원료로 사용합니다."
    },
    {
      "name": "압연",
      "desc": "금속을 회전하는 롤 사이로 눌러 판·코일 등의 형태로 만드는 가공입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "태양광",
      "desc": "햇빛을 태양전지 등으로 전기에너지로 바꾸는 발전 방식입니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "냉연강판",
      "desc": "금속 소재를 상온에 가까운 상태에서 압연해 두께와 표면 등을 가공한 강판입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "열연",
      "desc": "금속을 높은 온도에서 눌러 판·봉 등 형태로 만드는 가공입니다."
