  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "임상",
      "desc": "사람을 대상으로 의약품 등의 안전성과 효과를 평가하는 시험입니다."
    },
    {
      "name": "솔루션",
      "desc": "특정 업무나 문제를 해결하기 위해 제공하는 제품·기술·서비스의 묶음입니다."
    },
    {
      "name": "항체",
      "desc": "특정 표적에 결합하는 단백질로, 의약품의 치료·전달 기술에도 쓰입니다."
    },
    {
      "name": "플랫폼",
      "desc": "여러 제품·기술을 개발하거나 서비스를 제공하는 데 활용하는 공통 기반입니다. 여기서는 약물 전달 등 기술 기반을 뜻합니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "바이오마커",
      "desc": "질환 상태나 치료 반응 등을 평가하는 데 사용하는 생물학적 지표입니다."
    },
    {
      "name": "정합",
      "desc": "여기서는 전력·신호가 효율적으로 전달되도록 회로 조건을 맞추는 것을 뜻합니다."
    }
  ],
