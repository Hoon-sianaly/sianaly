    {
      "name": "가동률",
      "desc": "생산시설이 사용할 수 있는 능력에 비해 실제로 얼마나 사용됐는지를 나타내는 비율입니다."
    },
    {
      "name": "약물 전달",
      "desc": "약물이 몸 안의 목표 부위에 도달하도록 설계하는 기술·방식입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "경구",
      "desc": "약물을 입으로 복용하는 투여 방식을 뜻합니다."
    },
    {
      "name": "제형",
      "desc": "정제·캡슐·패치 등 약물이나 제품을 사용하기 쉽게 만든 형태입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "카타플라스마",
      "desc": "수분을 포함한 반죽 형태의 약물을 지지체에 바른 붙이는 의약품입니다."
    },
    {
      "name": "플라스타",
      "desc": "약물·점착제 등을 지지체에 도포한 붙이는 의약품입니다."
    },
    {
      "name": "경피",
      "desc": "피부를 통해 약물 등이 전달되는 방식을 뜻합니다."
    },
    {
      "name": "카타플라스마·플라스타",
      "desc": "피부에 붙여 사용하는 의약품 제형으로 수분·기제 등의 구성에 차이가 있습니다."
    }
