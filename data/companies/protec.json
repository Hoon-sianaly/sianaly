  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "패키징",
      "desc": "반도체 칩을 보호하고 외부 회로와 연결할 수 있도록 조립하는 과정입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "수지",
      "desc": "플라스틱·접착제·도료 등을 만드는 고분자 재료를 뜻합니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "벤처 투자",
      "desc": "초기·성장 단계 기업 등에 자금을 투자하고 성장·회수를 추진하는 사업입니다."
    },
    {
      "name": "검수",
      "desc": "납품한 제품·장비가 고객의 사양과 조건을 충족하는지 확인하는 절차입니다."
    },
    {
      "name": "후공정",
      "desc": "만들어진 반도체 칩을 조립·포장·검사하는 단계입니다."
    },
    {
      "name": "프로브카드",
      "desc": "웨이퍼 위 칩과 검사 장비 사이를 전기적으로 연결하는 검사 부품입니다."
    },
    {
      "name": "디스펜서",
      "desc": "수지·접착제 등을 원하는 위치와 양으로 정밀 도포하는 장비입니다."
    },
    {
      "name": "다이본더",
      "desc": "반도체 칩을 기판 등에 정밀하게 붙이는 장비입니다."
    }
  ],
