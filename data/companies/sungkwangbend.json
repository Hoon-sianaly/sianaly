  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "플랜트",
      "desc": "제품을 생산하거나 에너지·환경 처리를 수행하는 산업 설비입니다."
    },
    {
      "name": "LNG",
      "desc": "액화천연가스로, 매우 낮은 온도로 냉각해 액체 상태로 운송·보관합니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "수주잔고",
      "desc": "받은 주문 중 아직 매출·납품으로 완료하지 않은 금액입니다."
    },
    {
      "name": "합금",
      "desc": "둘 이상의 원소를 섞어 강도·내열성 등 필요한 성질을 갖도록 만든 금속입니다."
    },
    {
      "name": "관이음쇠",
      "desc": "배관을 연결하거나 방향·분기·굵기를 바꾸는 부품입니다."
    },
    {
      "name": "엘보",
      "desc": "배관의 진행 방향을 바꾸는 굽은 관이음쇠입니다."
    },
    {
      "name": "리듀서",
      "desc": "서로 다른 굵기의 배관을 연결하는 부품입니다."
    }
  ],
