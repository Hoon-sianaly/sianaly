  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "가동률",
      "desc": "공장·설비가 생산능력에 비해 실제로 사용된 정도입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "감가상각",
      "desc": "설비·장비 등의 취득 비용을 사용 기간에 걸쳐 나누어 비용으로 반영하는 것입니다."
    },
    {
      "name": "패키징",
      "desc": "반도체 칩을 보호하고 외부 회로와 연결할 수 있도록 조립하는 과정입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "후공정",
      "desc": "만들어진 반도체 칩을 조립·포장·검사하는 단계입니다."
    },
    {
      "name": "SoC",
      "desc": "시스템 온 칩으로, 여러 기능을 하나의 칩에 통합한 시스템반도체입니다."
    },
    {
      "name": "MCU",
      "desc": "제어 기능과 메모리 등을 통합해 기기 동작을 제어하는 반도체입니다."
    },
    {
      "name": "DP",
      "desc": "웨이퍼 검사 이후 양품 칩을 재배열·분류하는 다이 준비 작업입니다."
    }
  ],
