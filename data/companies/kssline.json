    },
    {
      "name": "운임",
      "desc": "사람이나 화물을 운송하는 대가로 받는 요금입니다."
    },
    {
      "name": "LPG",
      "desc": "액화석유가스입니다. 프로판·부탄 등을 압력이나 냉각으로 액화해 저장·운송하는 연료입니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "암모니아",
      "desc": "질소와 수소로 이루어진 화합물로, 비료 원료 등 여러 산업에서 사용합니다."
    },
    {
      "name": "메탄올",
      "desc": "화학제품 원료와 연료 등으로 사용되는 알코올 계열 물질입니다."
    },
    {
      "name": "용선",
      "desc": "선박을 소유한 주체로부터 정해진 조건으로 배를 빌려 사용하는 계약입니다."
    }
  ],
