  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "임상",
      "desc": "사람을 대상으로 의약품 등의 안전성과 효과를 평가하는 시험입니다."
    },
    {
      "name": "기술이전",
      "desc": "개발 기술이나 권리를 다른 회사에 제공하고 계약금·단계별 대금 등을 받는 계약입니다."
    },
    {
      "name": "항체",
      "desc": "특정 표적에 결합하는 단백질로, 의약품의 치료·전달 기술에도 쓰입니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "플랫폼",
      "desc": "여러 제품·기술을 개발하거나 서비스를 제공하는 데 활용하는 공통 기반입니다. 여기서는 약물 전달 등 기술 기반을 뜻합니다."
    },
    {
      "name": "표적 단백질 분해",
      "desc": "질병과 관련된 특정 단백질을 세포 안에서 분해하도록 유도하는 기술입니다."
    },
    {
      "name": "항체접합체",
      "desc": "항체에 약물을 연결해 특정 세포에 전달하도록 만든 물질입니다."
    }
