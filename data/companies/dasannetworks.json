  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "차입",
      "desc": "은행 대출이나 채권 발행 등으로 외부에서 돈을 빌리는 것입니다."
    },
    {
      "name": "소프트웨어",
      "desc": "컴퓨터·장치가 작업을 수행하도록 하는 프로그램입니다."
    },
    {
      "name": "솔루션",
      "desc": "특정 업무나 문제를 해결하기 위해 제공하는 제품·기술·서비스의 묶음입니다."
    },
    {
      "name": "열교환기",
      "desc": "서로 다른 유체 사이에 열을 전달하여 가열하거나 냉각하는 설비입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "현금 흐름",
      "desc": "일정 기간 실제로 들어오고 나가는 돈의 움직임입니다. 회계상 이익과 다를 수 있습니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "운전자금",
      "desc": "재고 확보와 외상 매출 회수 등 일상적인 영업에 필요한 자금입니다."
    },
    {
      "name": "쿼츠",
      "desc": "석영 소재를 뜻하며, 반도체 공정의 내열·고순도 부품 등에 사용됩니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
