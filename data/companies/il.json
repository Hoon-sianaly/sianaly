  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "계속기업",
      "desc": "회사가 가까운 미래에 영업을 계속한다는 회계상 전제입니다. 중요한 불확실성이 있다는 설명과 감사의견 거절은 구분합니다."
    },
    {
      "name": "의견거절",
      "desc": "감사인이 충분한 감사증거를 확보하지 못하는 등의 사유로 재무제표에 의견을 제시하지 않는 것입니다."
    },
    {
      "name": "적정",
      "desc": "감사인이 재무제표가 회계기준에 따라 중요하게 왜곡되지 않았다고 판단한 의견입니다. 투자 안전이나 미래 이익을 보증하는 뜻은 아닙니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "전장",
      "desc": "자동차 등의 전기·전자 장치와 관련 시스템을 뜻합니다."
    },
    {
      "name": "유동성",
      "desc": "필요한 때 지급할 현금과 자금을 마련할 수 있는 능력입니다."
    },
    {
      "name": "실리콘",
      "desc": "규소 기반 소재로, 반도체 칩과 제조장비 부품 등에 사용합니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
