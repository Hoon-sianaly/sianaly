  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "충당금",
      "desc": "미래에 발생할 것으로 예상되는 손실이나 지급 의무를 미리 회계에 반영한 금액입니다."
    },
    {
      "name": "차입",
      "desc": "은행 대출이나 채권 발행 등으로 외부에서 돈을 빌리는 것입니다."
    },
    {
      "name": "신용손실",
      "desc": "대출이나 채권에서 약정된 돈을 받지 못할 것으로 예상하거나 실제 발생한 손실입니다."
    },
    {
      "name": "캐피탈",
      "desc": "자동차 할부·리스나 기업·개인 대출 등의 금융 서비스를 제공하는 여신전문금융회사 등을 뜻합니다."
    },
    {
      "name": "리스",
      "desc": "회사 등이 구입한 자산을 고객이 일정 기간 사용하고 사용료를 내는 방식입니다."
    },
    {
      "name": "신용 위험",
      "desc": "거래 상대가 약정한 돈을 지급하지 못해 손실이 생길 수 있는 위험입니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "이익률",
      "desc": "매출 등 수익에 비해 이익이 얼마나 남는지 나타내는 비율입니다. 어떤 이익을 사용했는지 구분해야 합니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "대손",
      "desc": "대출금·판매대금 등을 회수하지 못해 발생하는 손실입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "순이자손익",
      "desc": "이자수익에서 이자비용을 뺀 금액입니다. 대출 원금이나 전체 영업손익과 다릅니다."
    },
    {
      "name": "여신금융",
      "desc": "대출·리스·할부 등으로 고객에게 자금이나 신용을 제공하는 금융업입니다."
    },
    {
      "name": "대손충당금",
      "desc": "대출·매출채권 등을 회수하지 못할 가능성에 대비해 반영하는 금액입니다."
    }
  ],
