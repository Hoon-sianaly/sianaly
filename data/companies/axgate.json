    {
      "name": "라이선스",
      "desc": "기술·소프트웨어·콘텐츠 등을 정해진 조건으로 사용할 수 있는 권리·계약입니다."
    },
    {
      "name": "소프트웨어",
      "desc": "컴퓨터·장치가 작업을 수행하도록 하는 프로그램입니다."
    },
    {
      "name": "솔루션",
      "desc": "특정 업무나 문제를 해결하기 위해 제공하는 제품·기술·서비스의 묶음입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "지관",
      "desc": "종이를 여러 겹 감거나 붙여 만든 관입니다. 원단·필름 등을 감는 심 등에 씁니다."
    },
    {
      "name": "관제",
      "desc": "장비·시스템의 상태를 감시하고 운용·제어하는 업무입니다."
    },
    {
      "name": "VPN",
      "desc": "공용망 등에서 암호화된 연결을 제공하는 가상사설망 기술입니다."
    },
    {
      "name": "방화벽",
      "desc": "허용 규칙에 따라 네트워크 통신을 통제하는 보안 장치·소프트웨어입니다."
    }
