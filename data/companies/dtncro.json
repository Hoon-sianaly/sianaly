  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "임상",
      "desc": "사람을 대상으로 의약품 등의 안전성과 효과를 평가하는 시험입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "수탁",
      "desc": "다른 회사의 의뢰를 받아 생산이나 업무를 대신 수행하는 것입니다."
    },
    {
      "name": "시험 수탁",
      "desc": "고객을 대신해 연구·시험 등을 수행하고 대가를 받는 서비스입니다."
    },
    {
      "name": "검체",
      "desc": "검사·분석에 사용하는 혈액이나 조직 같은 시료입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "비임상",
      "desc": "사람 대상 임상시험 전에 동물·세포 등으로 안전성 등을 확인하는 단계입니다."
    },
    {
      "name": "임상시험",
      "desc": "사람을 대상으로 약이나 의료기기의 안전성과 효과를 확인하는 시험입니다."
    }
  ],
