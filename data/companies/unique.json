    {
      "name": "가동률",
      "desc": "생산시설이 사용할 수 있는 능력에 비해 실제로 얼마나 사용됐는지를 나타내는 비율입니다."
    },
    {
      "name": "연료전지",
      "desc": "연료와 산화제의 화학 반응으로 전기를 만드는 장치입니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "유압",
      "desc": "액체의 압력을 이용해 힘과 움직임을 전달하는 방식입니다."
    },
    {
      "name": "전동화",
      "desc": "기계의 동력·제어 등에 전기 구동 장치를 적용하는 변화입니다."
    },
    {
      "name": "냉매",
      "desc": "냉장고·에어컨 등에서 열을 옮겨 냉각하는 데 사용하는 물질입니다."
    },
    {
      "name": "솔레노이드",
      "desc": "전류가 흐를 때 생기는 자기력으로 움직임을 만드는 장치입니다."
    },
    {
      "name": "밸브",
      "desc": "배관 속 유체의 흐름·방향·압력을 제어하는 부품입니다."
    },
    {
      "name": "전장",
      "desc": "자동차 등에 들어가는 전기·전자 장치와 부품을 뜻합니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "솔레노이드밸브",
