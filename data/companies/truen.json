  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "AI",
      "desc": "데이터를 학습해 인식·예측·생성 등의 작업을 수행하는 인공지능 기술입니다."
    },
    {
      "name": "클라우드",
      "desc": "서버·저장·소프트웨어 등의 자원을 네트워크로 이용하는 서비스 방식입니다."
    },
    {
      "name": "IP",
      "desc": "콘텐츠·캐릭터·기술 등 지적 창작물에 관한 권리인 지식재산을 뜻합니다."
    },
    {
      "name": "솔루션",
      "desc": "특정 업무나 문제를 해결하기 위해 제공하는 제품·기술·서비스의 묶음입니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "관제",
      "desc": "여러 장치나 차량의 상태를 한곳에서 파악하고 운행·작업을 관리하는 일입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "IP 카메라",
      "desc": "네트워크를 통해 영상을 전송하는 카메라입니다."
    }
