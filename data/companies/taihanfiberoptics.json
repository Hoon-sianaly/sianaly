  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "가동률",
      "desc": "공장·설비가 생산능력에 비해 실제로 사용된 정도입니다."
    },
    {
      "name": "차입",
      "desc": "은행 대출이나 채권 발행 등으로 외부에서 돈을 빌리는 것입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "현금 흐름",
      "desc": "일정 기간 실제로 들어오고 나가는 돈의 움직임입니다. 회계상 이익과 다를 수 있습니다."
    },
    {
      "name": "계속기업",
      "desc": "회사가 가까운 장래에도 사업을 이어갈 것이라는 회계상 전제입니다. 중요한 불확실성이 있으면 공시·감사 보고서를 함께 확인해야 합니다."
    },
    {
      "name": "의견거절",
      "desc": "감사인이 충분한 근거를 확보하지 못하는 등 이유로 재무제표에 감사의견을 표명하지 않은 상태입니다."
    },
    {
      "name": "적정",
      "desc": "감사인이 재무제표가 회계기준에 따라 중요하게 왜곡되지 않았다고 판단한 의견입니다. 투자 안전이나 미래 이익을 보증하는 뜻은 아닙니다."
    },
    {
      "name": "부적정",
      "desc": "감사 대상에 중요한 문제가 광범위하게 있다고 판단한 의견입니다. 이 페이지에서는 재무제표와 내부회계관리제도 중 어느 대상인지 함께 표시합니다."
    },
    {
      "name": "OPGW",
      "desc": "송전선의 가공지선에 광섬유를 포함해 통신 기능을 결합한 케이블입니다."
    }
  ],
