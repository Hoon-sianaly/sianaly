  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "양극재",
      "desc": "배터리 양극에 사용하는 소재입니다. 배터리의 용량·수명·안전성 등에 영향을 줍니다."
    },
    {
      "name": "전구체",
      "desc": "최종 물질을 만들기 전 단계의 원료입니다. 배터리에서는 양극재의 중간 원료, 의약품에서는 약물 합성에 쓰는 출발 물질 등을 뜻합니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "감가상각",
      "desc": "설비·장비 등의 취득 비용을 사용 기간에 걸쳐 나누어 비용으로 반영하는 것입니다."
    },
    {
      "name": "적정",
      "desc": "감사인이 재무제표가 회계기준에 따라 중요하게 왜곡되지 않았다고 판단한 의견입니다. 투자 안전이나 미래 이익을 보증하는 뜻은 아닙니다."
    },
    {
      "name": "엔지니어링",
      "desc": "전문기술을 활용해 시설·시스템을 조사·설계·구축·관리하는 업무입니다."
    },
    {
      "name": "NCM",
      "desc": "니켈·코발트·망간을 함께 사용하는 배터리 양극계 소재를 뜻합니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
