  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "디스플레이",
      "desc": "정보나 영상을 보여주는 화면 장치 또는 화면 패널을 뜻합니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "검수",
      "desc": "납품된 제품이나 시스템이 계약 조건을 충족하는지 고객이 확인하는 절차입니다."
    },
    {
      "name": "증착",
      "desc": "반도체 기판 등에 필요한 물질을 얇은 막 형태로 쌓는 제조 공정입니다."
    },
    {
      "name": "ALD",
      "desc": "원자층 증착으로, 표면 반응을 반복해 매우 얇고 균일한 막을 만드는 공정입니다."
    },
    {
      "name": "PECVD",
      "desc": "플라즈마를 이용해 화학 반응을 돕는 박막 증착 방식입니다."
    }
  ],
