  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "수율",
      "desc": "투입·생산한 물량 중 정상 제품으로 완성되는 비율입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "FPCB",
      "desc": "구부릴 수 있는 얇은 절연 소재 위에 회로를 만든 기판입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "필름",
      "desc": "얇은 막 형태의 소재로, 포장재와 전자 부품 등의 재료로 사용합니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "전장",
      "desc": "자동차 등에 들어가는 전기·전자 장치와 부품을 뜻합니다."
    },
    {
      "name": "회로기판",
      "desc": "전자부품을 지지하고 전기적으로 연결하는 회로가 형성된 판입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
