    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "손상",
      "desc": "자산에서 회수할 수 있는 금액이 장부금액보다 줄어든 경우 이를 회계에 반영하는 것입니다."
    },
    {
      "name": "윤활유",
      "desc": "기계 부품 사이의 마찰·마모를 줄이고 냉각·보호 등에 쓰는 오일입니다."
    },
    {
      "name": "폴리우레탄",
      "desc": "폼·섬유·도료 등에 사용하는 고분자 소재로, 배합과 제조 방식에 따라 성질이 달라집니다."
    },
    {
      "name": "재고 조정",
      "desc": "보유 상품·원료가 많거나 적을 때 주문·생산 등을 바꿔 재고 수준을 맞추는 과정입니다."
    },
    {
      "name": "폴리머",
      "desc": "작은 분자가 반복적으로 결합한 고분자로, 플라스틱 등 여러 소재의 바탕이 됩니다."
    },
    {
      "name": "안정제",
      "desc": "열·산화 등으로 소재 성능이 떨어지는 것을 줄이기 위해 넣는 첨가제입니다."
    },
    {
      "name": "PVC",
      "desc": "폴리염화비닐입니다. 건축자재·관·필름 등에 쓰이는 플라스틱입니다."
    }
