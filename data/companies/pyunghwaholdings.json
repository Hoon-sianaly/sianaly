    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "연료전지",
      "desc": "수소 등 연료와 산소의 전기화학 반응으로 전기와 열을 만드는 장치입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "지주회사",
      "desc": "다른 회사의 주식을 보유해 계열사를 지배·관리하는 회사입니다. 자체 사업을 함께 운영하기도 합니다."
    },
    {
      "name": "배당",
      "desc": "회사가 정해진 절차에 따라 주주에게 나누어 지급하는 돈이나 주식입니다."
    },
    {
      "name": "방진",
      "desc": "진동이 다른 부분으로 전달되는 것을 줄이는 기능입니다."
    },
    {
      "name": "금형",
      "desc": "동일한 모양의 제품을 반복해서 만들기 위한 틀입니다."
    },
    {
      "name": "오일씰",
      "desc": "회전축 등에서 기름이 새거나 이물질이 들어오는 것을 막는 부품입니다."
    },
    {
      "name": "가스켓",
      "desc": "맞닿는 부품 사이에 넣어 기체·액체가 새는 것을 막는 밀봉재입니다."
    }
  ],
