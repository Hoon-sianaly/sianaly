  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "가동률",
      "desc": "생산시설이 사용할 수 있는 능력에 비해 실제로 얼마나 사용됐는지를 나타내는 비율입니다."
    },
    {
      "name": "강관",
      "desc": "철강을 관 형태로 만든 제품입니다. 건설·기계·배관 등에 쓰입니다."
    },
    {
      "name": "수지",
      "desc": "플라스틱·접착제·도료 등을 만드는 고분자 재료를 뜻합니다."
    },
    {
      "name": "PVC",
      "desc": "배관·필름·생활용품 등에 쓰이는 염화비닐계 합성수지입니다."
    },
    {
      "name": "중단영업",
      "desc": "매각·종료 등을 이유로 계속하는 사업과 별도로 표시하는 영업입니다."
    },
    {
      "name": "감속기",
      "desc": "회전 속도를 낮추면서 필요한 회전 힘을 전달하는 장치입니다."
    },
    {
      "name": "합성수지",
      "desc": "화학적으로 합성한 고분자 소재로 플라스틱 제품의 원료로 쓰입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "방진",
      "desc": "진동이 다른 부분으로 전달되는 것을 줄이는 기능입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
