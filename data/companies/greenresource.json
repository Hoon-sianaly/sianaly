  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "손상",
      "desc": "이 페이지의 공정 부품 문맥에서는 부식·플라즈마 등에 의해 재료나 부품이 물리적으로 손상되는 것을 뜻합니다."
    },
    {
      "name": "선재",
      "desc": "가늘고 길게 가공한 금속 소재로 볼트·너트 등의 원료로 사용합니다."
    },
    {
      "name": "디스플레이",
      "desc": "정보나 영상을 보여주는 화면 장치 또는 화면 패널을 뜻합니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "검수",
      "desc": "납품한 제품·장비가 고객의 사양과 조건을 충족하는지 확인하는 절차입니다."
    },
    {
      "name": "플라즈마",
      "desc": "기체가 에너지를 받아 전기를 띤 입자로 나뉜 상태로, 반도체 처리·가스 분해 등에 활용됩니다."
    },
    {
      "name": "희토류",
      "desc": "자석·전자·첨단산업 등에 쓰이는 특정 금속 원소들의 묶음입니다."
    },
    {
      "name": "세라믹",
      "desc": "고온 공정을 통해 만드는 무기질 재료로, 전자·내열 부품 등에 쓰입니다."
    },
    {
      "name": "코팅",
      "desc": "소재 표면에 다른 물질을 얇게 입히는 공정입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
  ],
