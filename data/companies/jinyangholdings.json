  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "폴리우레탄",
      "desc": "폼·섬유·도료 등에 사용하는 고분자 소재로, 배합과 제조 방식에 따라 성질이 달라집니다."
    },
    {
      "name": "지주회사",
      "desc": "다른 회사의 주식을 보유해 계열사를 지배·관리하는 회사입니다. 자체 사업을 함께 운영하기도 합니다."
    },
    {
      "name": "수지",
      "desc": "플라스틱·접착제·도료 등을 만드는 고분자 재료를 뜻합니다."
    },
    {
      "name": "배당",
      "desc": "회사가 정해진 절차에 따라 주주에게 나누어 지급하는 돈이나 주식입니다."
    },
    {
      "name": "임대 수입",
      "desc": "보유 자산을 다른 사람이나 회사가 사용하도록 빌려주고 받는 대가입니다."
    },
    {
      "name": "폴리우레탄폼",
      "desc": "폴리우레탄 수지에 기포를 만들어 가볍고 탄력 있게 만든 소재입니다. 침구·신발·차량 내장재 등에 사용합니다."
    }
  ],
