  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "소프트웨어",
      "desc": "컴퓨터·장치가 작업을 수행하도록 하는 프로그램입니다."
    },
    {
      "name": "소모품",
      "desc": "기기 사용 과정에서 소진돼 교체·보충하는 재료입니다. 인쇄용 토너 등이 해당합니다."
    },
    {
      "name": "의견거절",
      "desc": "감사인이 충분한 근거를 얻지 못하는 등의 사유로 재무제표에 대한 감사의견을 제시하지 못한 상태입니다."
    },
    {
      "name": "적정",
      "desc": "감사인이 재무제표가 회계기준에 따라 중요하게 왜곡되지 않았다고 판단한 의견입니다. 투자 안전이나 미래 이익을 보증하는 뜻은 아닙니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "MALDI-TOF",
      "desc": "시료 성분을 이온으로 만든 뒤 이동 시간을 측정해 물질이나 미생물을 구분하는 질량분석 방식입니다."
    },
    {
      "name": "질량분석",
      "desc": "물질을 이루는 성분의 질량 특성을 측정해 종류와 양 등을 분석하는 방법입니다."
    }
  ],
