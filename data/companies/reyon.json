    },
    {
      "name": "감가상각",
      "desc": "차량·설비 등 자산의 취득 비용을 사용 기간에 걸쳐 나눠 비용으로 반영하는 회계 처리입니다."
    },
    {
      "name": "고정비",
      "desc": "생산·판매량이 달라져도 단기간에는 크게 변하지 않는 비용입니다."
    },
    {
      "name": "전문의약품",
      "desc": "의사의 처방 등이 필요한 의약품입니다."
    },
    {
      "name": "바이오의약품",
      "desc": "생물 유래 물질이나 생명공학 기술 등을 이용해 만드는 의약품입니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "수주",
      "desc": "고객의 주문·공사·납품 계약을 확보하는 것입니다. 실제 매출·이익과 발생 시점이 다를 수 있습니다."
    },
    {
      "name": "보험약가",
      "desc": "건강보험 급여가 적용되는 의약품에 정해진 가격 기준입니다."
    },
    {
      "name": "조영제",
      "desc": "의료 영상 촬영에서 장기·혈관 등의 구분을 돕기 위해 사용하는 의약품입니다."
    }
