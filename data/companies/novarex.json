  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "가동률",
      "desc": "공장·설비가 생산능력에 비해 실제로 사용된 정도입니다."
    },
    {
      "name": "ODM",
      "desc": "제조업체가 제품을 개발·설계하고 고객 브랜드에 공급하는 방식입니다."
    },
    {
      "name": "OEM",
      "desc": "다른 회사의 주문·설계 등에 따라 제품을 제조하는 방식입니다."
    },
    {
      "name": "건강기능식품",
      "desc": "인정된 기능성 원료나 성분 등을 사용해 제조하는 식품 분류입니다. 의약품과 구분합니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "기능성",
      "desc": "일반 제품의 기본 용도에 더해 특정 성능이나 사용 목적에 맞춘 특성을 뜻합니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
