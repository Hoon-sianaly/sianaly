    },
    {
      "name": "가동률",
      "desc": "생산시설이 사용할 수 있는 능력에 비해 실제로 얼마나 사용됐는지를 나타내는 비율입니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "강판",
      "desc": "철강을 판 모양으로 가공한 소재입니다. 강관·자동차 부품 등 여러 제품의 원료로 사용합니다."
    },
    {
      "name": "카메라 모듈",
      "desc": "영상 센서·렌즈 등을 결합해 촬영 기능을 제공하는 부품 단위입니다."
    },
    {
      "name": "밀봉",
      "desc": "틈으로 공기·물·유체 등이 새거나 들어오는 것을 막는 기능입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "전장",
      "desc": "자동차 등에 들어가는 전기·전자 장치와 부품을 뜻합니다."
    },
    {
      "name": "브래킷",
