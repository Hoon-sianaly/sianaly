  "overview": {
    "short": "율촌화학은 필름 기반 포장재와 전자·배터리 관련 소재를 만드는 회사",
    "summary": "율촌화학은 필름 기반 포장재와 전자·배터리 관련 소재를 만드는 회사입니다. 포장 사업은 식품과 생활용품 등에 쓰는 연포장·필름을 공급합니다.",
    "takeaways": [
      "율촌화학은 필름 기반 포장재와 전자·배터리 관련 소재를 만드는 회사입니다.",
      "포장 사업은 식품과 생활용품 등에 쓰는 연포장·필름을 공급합니다.",
      "전자 소재 사업은 전자기기와 배터리 분야의 고객에 필요한 소재를 공급합니다.",
      "포장과 전자 소재는 제품·고객과 투자 단계가 달라 각 사업의 수익성을 구분해야 합니다.",
      "새 설비의 실제 출하·가동률과 플라스틱·금속 원료 비용이 이익에 중요합니다."
    ],
    "business": [
      {
        "name": "식품·생활 포장재",
        "desc": "식품·생활·산업용 제품을 감싸는 연포장과 플라스틱 필름을 생산·공급합니다."
      },
      {
        "name": "전자·배터리 소재",
        "desc": "필름을 바탕으로 전자기기·배터리 분야에 사용하는 소재 부품을 제조합니다."
      },
      {
        "name": "소재 가공·생산",
        "desc": "고객 요구에 맞춘 필름 가공과 품질 관리를 수행하고 제조 설비·연구개발을 운영합니다."
      }
    ],
    "drivers": [
      {
        "title": "사업별 고객 주문",
        "desc": "식품 포장과 전자 소재는 수요가 다르게 움직일 수 있어 각 부문의 출하를 나눠 봅니다."
      },
      {
        "title": "투자 후 가동률",
        "desc": "설비 투자액보다 실제 판매 물량과 가동률, 고정비 회수 수준을 확인하는 것이 중요합니다."
      },
      {
        "title": "원료와 판매 조건",
        "desc": "플라스틱 수지·금속 등 원료비 변화를 제품 가격에 반영할 수 있는지 확인합니다."
      }
