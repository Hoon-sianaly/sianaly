  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "라이선스",
      "desc": "기술·브랜드·콘텐츠 등을 계약 조건에 따라 사용할 수 있는 권리입니다."
    },
    {
      "name": "손상",
      "desc": "자산의 회수 가능 가치가 장부금액보다 낮아졌을 때 손실을 회계에 반영하는 것입니다."
    },
    {
      "name": "적정",
      "desc": "감사인이 재무제표가 회계기준에 따라 중요하게 왜곡되지 않았다고 판단한 의견입니다. 투자 안전이나 미래 이익을 보증하는 뜻은 아닙니다."
    },
    {
      "name": "손상평가",
      "desc": "자산의 회수 가능한 가치가 장부금액보다 낮아졌는지 평가하는 절차입니다."
    },
    {
      "name": "용역",
      "desc": "제품 판매와 달리 공정 개발·분석·작업 등 서비스를 제공하는 사업입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "상장심사",
      "desc": "상장 유지 등을 거래소의 기준과 절차에 따라 검토하는 과정입니다."
    }
