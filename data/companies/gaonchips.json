  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "AI",
      "desc": "인공지능입니다. 데이터를 바탕으로 학습해 분류·예측·콘텐츠 생성 등의 작업을 수행하는 기술입니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "IP",
      "desc": "지적재산을 뜻합니다. 반도체에서는 재사용 가능한 설계 블록, 콘텐츠에서는 작품·아티스트 관련 권리 등을 가리킵니다."
    },
    {
      "name": "파운드리",
      "desc": "고객이 설계한 반도체를 주문받아 제조하는 사업입니다."
    },
    {
      "name": "소프트웨어",
      "desc": "컴퓨터·장치가 작업을 수행하도록 하는 프로그램입니다."
    },
    {
      "name": "솔루션",
      "desc": "특정 업무나 문제를 해결하기 위해 제공하는 제품·기술·서비스의 묶음입니다."
    },
    {
      "name": "패키징",
      "desc": "반도체 칩을 보호하고 외부 회로와 연결할 수 있도록 조립하는 과정입니다."
    },
    {
      "name": "리스",
      "desc": "자산을 일정 기간 사용할 권리를 제공하고 이용료를 받는 계약입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "팹리스",
      "desc": "자체 반도체 제조 공장보다 설계에 집중하고 생산은 외부 전문 업체를 활용하는 기업입니다."
    }
