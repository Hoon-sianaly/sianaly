  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "벤처투자",
      "desc": "성장 가능성이 있는 초기·신생 기업 등에 자금을 투자하는 사업입니다."
    },
    {
      "name": "자기자본 투자",
      "desc": "외부 고객의 자금이 아니라 회사가 보유한 자금 등을 투자하는 사업입니다."
    },
    {
      "name": "사모펀드",
      "desc": "제한된 투자자의 자금을 모아 운용하는 펀드입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "투자조합",
      "desc": "여러 출자자의 자금을 모아 기업 등에 투자하고 수익을 배분하는 투자기구입니다."
    },
    {
      "name": "관리보수",
      "desc": "펀드·조합 등을 관리·운용한 대가로 받는 보수입니다."
    },
    {
      "name": "성과보수",
      "desc": "정해진 투자 성과 등의 조건을 달성할 때 받는 추가 보수입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "영업수익",
      "desc": "회사의 주된 영업활동에서 발생하는 수익입니다. 금융·투자 회사에서는 대출 원금이나 펀드 규모와 구분합니다."
    }
  ],
