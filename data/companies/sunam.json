  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "수율",
      "desc": "투입·생산한 물량 중 정상 제품으로 완성되는 비율입니다."
    },
    {
      "name": "고정비",
      "desc": "생산·판매량이 달라져도 단기간에는 크게 변하지 않는 비용입니다."
    },
    {
      "name": "선재",
      "desc": "가늘고 길게 가공한 금속 소재로 볼트·너트 등의 원료로 사용합니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "증착",
      "desc": "재료를 표면에 얇은 막 형태로 쌓는 공정입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "박막",
      "desc": "표면에 매우 얇게 형성한 물질의 층입니다."
    },
    {
      "name": "고온초전도",
      "desc": "일반 초전도체보다 높은 온도에서 초전도 현상이 나타나는 특성입니다. 상온 작동을 뜻하지 않습니다."
    }
  ],
