    },
    {
      "name": "전동화",
      "desc": "기존 기계식 장치나 내연기관 기능을 전기·전자 장치로 전환하는 것입니다."
    },
    {
      "name": "액추에이터",
      "desc": "전기 등의 에너지를 움직임으로 바꾸는 부품으로, 여기서는 카메라 초점·보정용 구동부입니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "배터리팩",
      "desc": "여러 배터리 셀·모듈과 제어·보호장치 등을 묶은 배터리 시스템입니다."
    },
    {
      "name": "밸브",
