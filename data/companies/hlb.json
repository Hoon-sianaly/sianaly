  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "커머스",
      "desc": "상품이나 서비스를 사고파는 사업입니다. 이 페이지에서는 온라인 쇼핑·선물하기 등의 서비스를 뜻합니다."
    },
    {
      "name": "임상",
      "desc": "사람을 대상으로 의약품 등의 안전성과 효과를 확인하는 연구 단계입니다."
    },
    {
      "name": "체외진단",
      "desc": "혈액·소변 등의 검체를 몸 밖에서 검사하여 질병이나 건강 상태를 확인하는 방식입니다."
    },
    {
      "name": "의약외품",
      "desc": "의약품과 구분해 관리하는 보건 관련 제품 분류입니다. 일부 구강·위생 제품 등이 해당합니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "소모품",
      "desc": "기기 사용 과정에서 소진돼 교체·보충하는 재료입니다. 인쇄용 토너 등이 해당합니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    }
  ],
