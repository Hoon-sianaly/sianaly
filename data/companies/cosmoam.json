    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "가동률",
      "desc": "생산설비가 만들 수 있는 양에 비해 실제 얼마나 생산하고 있는지를 나타내는 비율입니다."
    },
    {
      "name": "수율",
      "desc": "생산한 제품 중 정상적으로 판매할 수 있는 양품의 비율입니다."
    },
    {
      "name": "양극활물질",
      "desc": "배터리 양극에서 전기를 저장하고 내보내는 반응에 참여하는 핵심 소재입니다."
    },
    {
      "name": "양극재",
      "desc": "배터리 양극에 사용하는 소재입니다. 배터리의 용량·수명·안전성 등에 영향을 줍니다."
    },
    {
      "name": "운전자본",
      "desc": "재고·매출채권·매입채무 등 일상적인 영업 과정에 필요한 자금과 관련된 항목입니다."
    },
    {
      "name": "이차전지",
      "desc": "충전해 반복적으로 사용할 수 있는 배터리입니다."
    },
    {
      "name": "MLCC",
      "desc": "여러 층의 세라믹과 전극을 쌓아 만든 작은 콘덴서입니다. 전자 회로의 전기를 저장·조절합니다."
    },
    {
      "name": "이형필름",
      "desc": "붙어 있는 다른 소재를 쉽게 떼어낼 수 있도록 표면을 처리한 필름입니다."
    },
    {
      "name": "토너",
      "desc": "레이저 프린터·복사기에서 글자와 그림을 종이에 인쇄할 때 사용하는 분말입니다."
    }
