  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "기업금융",
      "desc": "기업의 자금조달·투자·인수합병 등에 필요한 금융 서비스를 제공하는 사업입니다."
    },
    {
      "name": "파생상품",
      "desc": "주식·금리·환율 등의 가격이나 지표에 따라 가치가 달라지는 금융상품입니다."
    },
    {
      "name": "판관비",
      "desc": "판매비와 관리비입니다. 제품 판매와 회사 운영에 드는 비용을 뜻합니다."
    },
    {
      "name": "판관비 차감 전 영업손익",
      "desc": "영업이익에 판매비와 관리비를 더한 계산 지표입니다. 금융상품 매매 총액을 포함한 영업수익이나 제조업 매출과 구분합니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "이익률",
      "desc": "매출 등 수익에 비해 이익이 얼마나 남는지 나타내는 비율입니다. 어떤 이익을 사용했는지 구분해야 합니다."
    },
    {
      "name": "인수·주선",
      "desc": "증권 발행이나 자금 조달 과정에서 판매·모집과 거래 성사를 지원하는 업무입니다."
    }
