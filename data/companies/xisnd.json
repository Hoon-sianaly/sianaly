  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "데이터센터",
      "desc": "서버·저장장치·네트워크 장비와 이를 운영할 전력·냉각 설비를 모아 놓은 시설입니다."
    },
    {
      "name": "플랜트",
      "desc": "제품을 생산하거나 에너지·환경 처리를 수행하는 산업 설비입니다."
    },
    {
      "name": "프로젝트 금융",
      "desc": "특정 사업에서 발생할 현금 흐름 등을 바탕으로 조달하는 금융이며, 사업 지연·부진에 따라 회수 위험이 달라집니다."
    },
    {
      "name": "솔루션",
      "desc": "특정 업무나 문제를 해결하기 위해 제공하는 제품·기술·서비스의 묶음입니다."
    },
    {
      "name": "스마트홈",
      "desc": "가정의 기기·설비를 통신망으로 연결해 제어·관리하는 시스템입니다."
    },
    {
      "name": "수주 잔고",
      "desc": "이미 계약한 주문 중 아직 매출로 반영되지 않은 물량이나 금액입니다. 미래 이익이 확정됐다는 뜻은 아닙니다."
    },
    {
      "name": "현금 흐름",
      "desc": "일정 기간 실제로 들어오고 나가는 돈의 움직임입니다. 회계상 이익과 다를 수 있습니다."
    },
    {
      "name": "대금 회수",
      "desc": "상품이나 서비스를 제공한 뒤 고객에게 받을 돈을 실제로 받는 것입니다."
    },
    {
      "name": "이익률",
      "desc": "매출 등 수익에 비해 이익이 얼마나 남는지 나타내는 비율입니다. 어떤 이익을 사용했는지 구분해야 합니다."
    }
  ],
