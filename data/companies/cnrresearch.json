  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "임상",
      "desc": "사람을 대상으로 의약품 등의 안전성과 효과를 평가하는 시험입니다."
    },
    {
      "name": "수주 잔고",
      "desc": "이미 계약한 주문 중 아직 매출로 반영되지 않은 물량이나 금액입니다. 미래 이익이 확정됐다는 뜻은 아닙니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "수탁",
      "desc": "다른 회사의 의뢰를 받아 생산이나 업무를 대신 수행하는 것입니다."
    },
    {
      "name": "시험 수탁",
      "desc": "고객을 대신해 연구·시험 등을 수행하고 대가를 받는 서비스입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "시판 후 조사",
      "desc": "의약품이 판매된 뒤 실제 사용 환경에서 안전성 등을 조사하는 활동입니다."
    },
    {
      "name": "임상시험",
      "desc": "사람을 대상으로 약이나 의료기기의 안전성과 효과를 확인하는 시험입니다."
    }
  ],
