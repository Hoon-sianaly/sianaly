  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "선재",
      "desc": "가늘고 길게 가공한 금속 소재로 볼트·너트 등의 원료로 사용합니다."
    },
    {
      "name": "강판",
      "desc": "철강을 판 모양으로 가공한 소재입니다. 강관·자동차 부품 등 여러 제품의 원료로 사용합니다."
    },
    {
      "name": "철근",
      "desc": "콘크리트 구조물의 강도를 보완하기 위해 넣는 철강 봉 제품입니다."
    },
    {
      "name": "대금 회수",
      "desc": "상품이나 서비스를 제공한 뒤 고객에게 받을 돈을 실제로 받는 것입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "플레이트",
      "desc": "평평한 판 형태의 소재·부품입니다. 여기서는 금형·정밀가공용 판을 뜻합니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
  ],
