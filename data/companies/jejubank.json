  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "순이자이익",
      "desc": "이자수익에서 이자비용을 뺀 금액입니다. 수수료·투자 손익까지 포함한 전체 이익은 아닙니다."
    },
    {
      "name": "신용손실",
      "desc": "대출이나 채권에서 약정된 돈을 받지 못할 것으로 예상하거나 실제 발생한 손실입니다."
    },
    {
      "name": "신용 위험",
      "desc": "거래 상대가 약정한 돈을 지급하지 못해 손실이 생길 수 있는 위험입니다."
    },
    {
      "name": "조달",
      "desc": "사업에 필요한 자금·원료·제품 등을 확보하는 것입니다. 은행에서는 예금 등으로 운용 자금을 마련하는 의미로 쓰입니다."
    },
    {
      "name": "대출 건전성",
      "desc": "대출금을 약정대로 회수할 수 있는지를 나타내는 상태입니다. 연체와 신용손실 등을 함께 확인합니다."
    }
  ],
