  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "가동률",
      "desc": "생산시설이 사용할 수 있는 능력에 비해 실제로 얼마나 사용됐는지를 나타내는 비율입니다."
    },
    {
      "name": "양산",
      "desc": "개발과 시험을 마친 제품을 판매·공급하기 위해 대량으로 생산하는 단계입니다."
    },
    {
      "name": "프레스",
      "desc": "재료에 압력을 가해 원하는 형태로 만드는 가공 방식입니다."
    },
    {
      "name": "사출",
      "desc": "녹인 플라스틱 등을 금형에 주입해 모양을 만드는 제조 방식입니다."
    },
    {
      "name": "수지",
      "desc": "플라스틱·접착제·도료 등을 만드는 고분자 재료를 뜻합니다."
    },
    {
      "name": "복합기",
      "desc": "인쇄·복사·스캔 등 여러 기능을 한 기기에 갖춘 사무기기입니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "사출금형",
      "desc": "녹인 플라스틱 등을 틀 안에 넣어 원하는 형상으로 굳히는 금형입니다."
    },
    {
      "name": "코어",
      "desc": "전자장치에서 자기력·전력 변환 등을 돕는 중심 자성 부품을 뜻합니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    }
  ],
