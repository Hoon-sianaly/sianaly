  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "차입",
      "desc": "은행 대출이나 채권 발행 등으로 외부에서 돈을 빌리는 것입니다."
    },
    {
      "name": "냉연",
      "desc": "금속을 상온에 가까운 상태에서 압연해 두께·표면 등을 가공하는 공정입니다."
    },
    {
      "name": "강판",
      "desc": "철강을 판 모양으로 가공한 소재입니다. 강관·자동차 부품 등 여러 제품의 원료로 사용합니다."
    },
    {
      "name": "도금",
      "desc": "금속 표면에 다른 금속을 입혀 부식 방지 등 특성을 더하는 가공입니다."
    },
    {
      "name": "마진",
      "desc": "판매가격과 매입·제조 비용 등의 차이를 뜻합니다. 모든 비용을 차감한 최종 이익과는 다를 수 있습니다."
    },
    {
      "name": "도금강판",
      "desc": "부식을 줄이기 위해 표면에 아연 등 금속층을 입힌 강판입니다."
    },
    {
      "name": "컬러강판",
      "desc": "강판 표면에 색상·무늬와 보호 기능을 가진 도료를 입힌 제품입니다."
    },
    {
      "name": "코일센터",
      "desc": "롤 형태의 강판을 고객 규격에 맞게 절단·가공해 공급하는 사업장입니다."
    }
  ],
