  "glossary": [
    {
      "name": "별도 기준",
      "desc": "자회사의 실적을 합산하지 않고 해당 회사 자체의 재무 정보를 표시한 기준입니다."
    },
    {
      "name": "위탁생산",
      "desc": "다른 회사의 주문을 받아 제품을 대신 생산하는 사업입니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "바이오시밀러",
      "desc": "기존 바이오의약품과 품질·안전성·유효성이 매우 유사함을 입증한 의약품입니다."
    },
    {
      "name": "임상",
      "desc": "사람을 대상으로 의약품 등의 안전성과 효과를 평가하는 시험입니다."
    },
    {
      "name": "바이오의약품",
      "desc": "생물 유래 물질이나 생명공학 기술 등을 이용해 만드는 의약품입니다."
    },
    {
      "name": "연구개발",
      "desc": "새 제품·기술을 연구하고 실제 사용할 수 있도록 개발하는 활동입니다. 지출이 곧바로 매출이나 성공을 뜻하지는 않습니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "비임상",
      "desc": "사람 대상 임상시험에 앞서 효능·안전성 등을 확인하는 연구·시험 단계입니다."
    },
    {
      "name": "EPO",
      "desc": "적혈구 생성을 촉진하는 물질로 빈혈 치료용 바이오의약품 등에 사용됩니다."
    },
    {
      "name": "GMP",
      "desc": "의약품의 품질과 안전성을 위한 제조·관리 기준입니다."
    }
  ],
