  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "공정",
      "desc": "제품을 만들거나 설비를 완성하기 위해 순서대로 진행하는 작업 단계입니다."
    },
    {
      "name": "PCB",
      "desc": "인쇄회로기판으로 전자부품을 지지하고 전기 신호를 연결하는 기판입니다."
    },
    {
      "name": "동박",
      "desc": "구리를 얇게 편 막으로, 회로기판과 배터리 전극 등에 사용합니다."
    },
    {
      "name": "납품",
      "desc": "주문받은 제품을 정해진 조건에 맞춰 고객에게 공급하는 것입니다."
    },
    {
      "name": "소모품",
      "desc": "기기 사용 과정에서 소진돼 교체·보충하는 재료입니다. 인쇄용 토너 등이 해당합니다."
    },
    {
      "name": "수주",
      "desc": "고객에게 공사·제품·서비스 주문을 받는 것입니다. 계약 금액이 즉시 전부 매출이 되는 것은 아닙니다."
    },
    {
      "name": "검수",
      "desc": "납품한 제품·장비가 고객의 사양과 조건을 충족하는지 확인하는 절차입니다."
    },
    {
      "name": "습식",
      "desc": "액체 약품 등을 사용해 표면을 처리하거나 소재를 가공하는 방식입니다."
    },
    {
      "name": "식각",
      "desc": "필요 없는 부분을 선택적으로 제거해 회로 등의 모양을 만드는 공정입니다."
    },
    {
      "name": "복합동박",
      "desc": "다른 소재 층과 구리층을 결합한 얇은 소재로, 배터리용 집전체 등에 적용을 추진합니다."
    }
  ],
