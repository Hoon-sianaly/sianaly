  "glossary": [
    {
      "name": "연결 기준",
      "desc": "회사와 지배하는 자회사의 재무 정보를 하나로 합친 기준입니다. 내부 거래는 제거합니다."
    },
    {
      "name": "계속사업",
      "desc": "회사가 앞으로도 영위하는 사업으로 분류한 활동입니다. 매각·종료 등으로 구분한 중단사업과 비교 범위가 다를 수 있습니다."
    },
    {
      "name": "중단사업",
      "desc": "매각·종료 등으로 계속사업과 구분해 손익을 별도로 표시하는 사업입니다."
    },
    {
      "name": "배터리팩",
      "desc": "여러 배터리 셀·모듈과 제어·보호장치 등을 묶은 배터리 시스템입니다."
    },
    {
      "name": "재분류",
      "desc": "사업 구분이나 회계 표시가 바뀌어 과거 비교 수치를 같은 기준으로 다시 나누는 것입니다."
    },
    {
      "name": "웨어러블",
      "desc": "몸에 착용할 수 있는 형태의 기기입니다."
    },
    {
      "name": "반기",
      "desc": "6개월 기간입니다. 반기 누적 실적은 한 분기의 3개월 실적과 다릅니다."
    },
    {
      "name": "보호회로",
      "desc": "과충전·과방전·과전류 등으로부터 배터리를 보호하는 전자 회로입니다."
    },
    {
      "name": "POC",
      "desc": "배터리 보호 기능을 하나의 칩에 통합한 제품을 뜻합니다."
    },
    {
      "name": "PMP",
      "desc": "배터리 보호 회로와 관련 부품을 작은 패키지로 묶은 제품을 뜻합니다."
    }
